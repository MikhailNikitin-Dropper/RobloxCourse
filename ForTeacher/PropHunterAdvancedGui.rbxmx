			<Properties>
				<ProtectedString name="Source"><![CDATA[local model = script.Parent

local function copyChildren(from, to)
	for _, child in ipairs(from:GetChildren()) do
		child:Clone().Parent = to
	end
end

copyChildren(model.ReplicatedStorage, game:GetService("ReplicatedStorage"))
copyChildren(model.ServerScriptService, game:GetService("ServerScriptService"))
--copyChildren(model.StarterGui, game:GetService("StarterGui"))
copyChildren(model.StarterPlayerScripts, game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"))

print("PropHunter installed.")
script:Destroy()
model:Destroy()]]></ProtectedString>
