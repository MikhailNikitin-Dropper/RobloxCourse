						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")

local Registry = require(script.Parent.Registry)
local Config = require(script.Parent.Config)

local Scanner = {}

local Started = false

function Scanner:Scan()
	for _, model in ipairs(CollectionService:GetTagged(Config.Tag)) do
		if model:IsA("Model") then
			Registry:Add(model)
		end
	end
end

function Scanner:Start()

	if Started then
		return
	end

	Started = true

	self:Scan()

	CollectionService:GetInstanceAddedSignal(Config.Tag):Connect(function(instance)

		if instance:IsA("Model") then
			Registry:Add(instance)
		end

	end)

	CollectionService:GetInstanceRemovedSignal(Config.Tag):Connect(function(instance)

		Registry:Remove(instance)

	end)
end

return Scanner]]></ProtectedString>
						<string name="ScriptGuid">{ECB7E803-B3D9-49C7-A901-C71EB24C5A75}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Scanner</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX222E873AA25A42A7BD1934A78759BC4D">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Registry = {}

Registry.Items = {}

Registry.Added = Instance.new("BindableEvent")
Registry.Removed = Instance.new("BindableEvent")
Registry.Collected = Instance.new("BindableEvent")

function Registry:Add(model)
	if self.Items[model] then
		return
	end

	local Item = {
		Model = model,
		Name = model.Name,
		Distance = 0,
		Collected = false
	}

	self.Items[model] = Item

	self.Added:Fire(Item)
end

function Registry:Remove(model)
	local Item = self.Items[model]

	if Item then
		self.Removed:Fire(Item)
	end

	self.Items[model] = nil
end

function Registry:SetCollected(model)
	local Item = self.Items[model]

	if not Item then
		return
	end

	if Item.Collected then
		return
	end

	Item.Collected = true

	self.Collected:Fire(Item)
end

function Registry:GetItems()
	return self.Items
end

return Registry]]></ProtectedString>
