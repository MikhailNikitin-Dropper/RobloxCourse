				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer

local PropHunter = require(
	ReplicatedStorage.PropHunter.Init
)

local Gui = Player.PlayerGui:WaitForChild("PropHunterGui")

PropHunter.Start(Gui)

ReplicatedStorage.PropHunter.Remotes.SyncCollected.OnClientEvent:Connect(function(model: Model) 
	print("Synced", model.Name)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Transparency = 1
		end
	end
end)]]></ProtectedString>
