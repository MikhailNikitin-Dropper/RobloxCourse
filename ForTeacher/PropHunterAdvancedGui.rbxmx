						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Обновлённая версия ReplicatedStorage/PropHunter/GuiController (урок 7).
-- Отличие от версии из Prop Hunt.rbxmx: строка списка больше не создаётся
-- кодом (Instance.new("TextButton")), а клонируется из шаблона ItemTemplate,
-- который ученик собирает руками внутри MainFrame.ScrollingFrame.
--
-- Требуемая структура ItemTemplate (Frame, лежит в ScrollingFrame рядом с
-- будущими строками списка):
--   ItemTemplate (Frame)
--     Icon           (ImageLabel)  -- иконка предмета, подставляется из Decal
--     NameLabel      (TextLabel)   -- имя предмета
--     DistanceLabel  (TextLabel)   -- "78m" / скрывается при сборе
--     CheckIcon      (ImageLabel)  -- галочка, показывается при сборе
--
-- Sам ItemTemplate можно оставить Visible = true во время сборки в Studio —
-- скрипт сам спрячет его первой же строкой Start(), как только игра запустится.
--
-- Иконка каждого предмета в списке берётся не из шаблона, а с самого предмета
-- в мире: первый попавшийся Decal внутри модели даёт Texture для Icon. Так
-- одна и та же карточка-шаблон подхватывает свою картинку у каждого предмета
-- отдельно, без ручной сборки карточки под каждый тип предмета.

local Players = game:GetService("Players")

local Registry = require(script.Parent.Registry)
local Config = require(script.Parent.Config)

local GuiController = {}

local Player = Players.LocalPlayer

local Frame

local WinFrame
local InfoFrame
local InfoLabel
local Template

local Rows = {}

local HasWon = false
local ShownInfo = {}

local DEFAULT_ICON = "rbxasset://textures/ui/GuiImagePlaceholder.png"

local function GetIcon(model)
	local decal = model:FindFirstChildWhichIsA("Decal", true)

	if decal and decal.Texture ~= "" then
		return decal.Texture
	end

	return DEFAULT_ICON
end

local function CheckWin()
	if HasWon then
		return
	end

	local hasItems = false

	for _, item in pairs(Registry:GetItems()) do
		hasItems = true

		if not item.Collected then
			return
		end
	end

	if not hasItems then
		return
	end

	HasWon = true

	WinFrame.Visible = true

	task.delay(3, function()
		if WinFrame then
			WinFrame.Visible = false
		end
	end)
end

local function ShowItemInfo(item)
	if ShownInfo[item.Model] then
		return
	end

	local Value = item.Model:FindFirstChildWhichIsA("StringValue")
	if not Value then
		return
	end

	ShownInfo[item.Model] = true

	InfoLabel.Text = Value.Value
	InfoFrame.Visible = true

	task.delay(3, function()
		InfoFrame.Visible = false
	end)
end

local function UpdateLabel(item)
	local Row = Rows[item.Model]

	if not Row then
		return
	end

	Row.NameLabel.Text = item.Name

	if item.Collected then
		Row.DistanceLabel.Visible = false
		Row.CheckIcon.Visible = true
		Row.NameLabel.TextColor3 = Color3.fromRGB(0, 255, 0)

		ShowItemInfo(item)
	else
		Row.DistanceLabel.Visible = true
		Row.DistanceLabel.Text = string.format("%.0fm", item.Distance)
		Row.CheckIcon.Visible = false
		Row.NameLabel.TextColor3 = Color3.new(1, 1, 1)
	end
end

local function CreateLabel(item)
	local Row = Template:Clone()

	Row.Name = item.Name
	Row.Icon.Image = GetIcon(item.Model)
	Row.Visible = true
	Row.Parent = Frame

	Rows[item.Model] = Row

	UpdateLabel(item)
end

local function RemoveLabel(item)
	local Row = Rows[item.Model]

	if Row then
		Row:Destroy()
		Rows[item.Model] = nil
	end
end

function GuiController:Start(gui)

	Frame = gui.MainFrame.ScrollingFrame

	Template = Frame:WaitForChild("ItemTemplate")
	Template.Visible = false

	WinFrame = gui:WaitForChild("WinFrame")
	WinFrame.Visible = false

	InfoFrame = gui:WaitForChild("InfoFrame")
	InfoLabel = InfoFrame:WaitForChild("TextLabel")
	InfoFrame.Visible = false

	Registry.Added.Event:Connect(CreateLabel)
	Registry.Removed.Event:Connect(RemoveLabel)
	Registry.Collected.Event:Connect(UpdateLabel)

	for _, item in pairs(Registry:GetItems()) do
		CreateLabel(item)
	end

	task.spawn(function()

		while true do

			task.wait(Config.RefreshRate)

			local Character = Player.Character
			if not Character then
				continue
			end

			local Root = Character:FindFirstChild("HumanoidRootPart")
			if not Root then
				continue
			end


			local Items = {}

			for _, item in pairs(Registry:GetItems()) do

				if item.Model and item.Model.Parent then

					item.Distance = (Root.Position - item.Model:GetPivot().Position).Magnitude

					if item.Distance <= Config.MaxDistance then
						table.insert(Items, item)
					end

				end

			end

			table.sort(Items, function(a, b)

				if a.Collected ~= b.Collected then
					return not a.Collected
				end

				return a.Distance < b.Distance

			end)

			for index, item in ipairs(Items) do

				local Row = Rows[item.Model]

				if Row then

					UpdateLabel(item)

					Row.LayoutOrder = index

				end

			end

			CheckWin()

		end

	end)

end

return GuiController
]]></ProtectedString>
						<string name="ScriptGuid">{A74A1CA0-918A-4A7B-B642-118CF456BC8C}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">GuiController</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
