	<Item class="Script" referent="RBX16F9B055C7D54C5CA897587F4D2745A6">
		<Properties>
			<ProtectedString name="Source"><![CDATA[-- Камнепад: возвращает валун наверх, чтобы обвал повторялся.
-- Пауза между падениями — в атрибуте Pause самого валуна (секунды).
--
-- Модуль курса для урока 21. Лежит внутри валуна (Part формы Ball,
-- Density 2, Anchored снят). Всё остальное делает физика: скатывание,
-- разгон по жёлобу и удар по игроку.
local rock = script.Parent
local home = rock.CFrame

while true do
	task.wait(script:GetAttribute("Pause") or 3)
	rock.Anchored = true
	rock.CFrame = home
	rock.Anchored = false
end
]]></ProtectedString>
