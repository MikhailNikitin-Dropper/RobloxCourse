				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">CamServer</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX9D311E0E029D4F2D8E5030CD5478C363">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- CamClient — камера за плечом и наводка (урок 20).
--
-- Это Script с RunContext = Client: такой скрипт лежит прямо в папке модуля и
-- запускается сам у каждого игрока. Обычный LocalScript в Workspace не
-- работает, и модуль пришлось бы разносить по StarterPlayer.
--
-- Что делает:
--   * держит камеру за ПРАВЫМ плечом персонажа;
--   * поворачивает персонажа туда, куда смотрит камера (вправо-влево);
--   * держит руку с оружием анимацией наводки (вверх-вниз);
--   * находит точку под прицелом и объявляет её оружию;
--   * шлёт эту точку на сервер: ему она нужна для проверки выстрелов.
--
-- Камерой правим сами, а не подкручиваем стандартную: курсор заперт в центре
-- экрана, и мы читаем его сдвиг за кадр. Поэтому вид не «догоняет» мышь и
-- целиться удобно.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local module = script.Parent
local Core = require(module:WaitForChild("CamCore"))
local aimEvent = module:WaitForChild("Aim")

local player = Players.LocalPlayer

local yaw = 0    -- вправо-влево, радианы
local pitch = 0  -- вверх-вниз
local sentAim = Vector3.new() -- куда целились, когда последний раз слали серверу
local sentAt = 0
local given = false -- вернули ли управление стандартной камере

-- --- мышь ------------------------------------------------------------------

-- Delta — сдвиг курсора за кадр в пикселях; чувствительность переводит его в
-- градусы. Взгляд вверх-вниз упирается в пределы: свернуть себе шею игрок не
-- должен.
UserInputService.InputChanged:Connect(function(input, busy)
	if busy or input.UserInputType ~= Enum.UserInputType.MouseMovement then
		return
	end
	local cfg = Core.config(module)
	if not cfg.Enabled then
		return
	end
	yaw = yaw - math.rad(input.Delta.X * cfg.Sensitivity)
	pitch = math.clamp(
		pitch - math.rad(input.Delta.Y * cfg.Sensitivity),
		math.rad(cfg.MinPitch),
		math.rad(cfg.MaxPitch)
	)
end)

-- --- персонаж --------------------------------------------------------------

-- Отправка точки прицела серверу. Сам себе игрок наводит оружие мгновенно, но
-- сервер об этом не знает, а проверять выстрелы ему нужно.
local function sendAim(target)
	sentAim = target
	sentAt = os.clock()
	aimEvent:FireServer(target)
end

-- Перед выстрелом точку шлём НЕМЕДЛЕННО, не дожидаясь очереди: сервер
-- проверяет выстрел по своей копии прицела, и если она отстала на долю
-- секунды, на быстром развороте заряд уйдёт в сторону.
local hooked = setmetatable({}, { __mode = "k" }) -- один раз на каждое оружие

local function watch(tool)
	if not tool:IsA("Tool") or hooked[tool] then
		return
	end
	hooked[tool] = true
	tool.Activated:Connect(function()
		local character = player.Character
		local cfg = Core.config(module)
		if character and cfg.Enabled and cfg.MoveArm and tool.Parent == character then
			sendAim(Core.target(character, cfg))
		end
	end)
end

-- Новый персонаж: камера должна смотреть туда же, куда он стоит, иначе на
-- каждом возрождении вид дёргался бы.
local function start(character)
	character.ChildAdded:Connect(watch)
	for _, child in ipairs(character:GetChildren()) do
		watch(child)
	end

	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root then
		local _, y = root.CFrame:ToOrientation()
		yaw = y
		pitch = 0
	end
end

player.CharacterAdded:Connect(start)
if player.Character then
	task.spawn(start, player.Character)
end

-- Отдать управление обратно: модуль выключили атрибутом Enabled.
local function giveBack()
	given = true
	workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.AutoRotate = true
	end
	if character then
		Core.relax(character)
	end
end

local function update()
	local cfg = Core.config(module)
	if not cfg.Enabled then
		if not given then
			giveBack()
		end
		return
	end
	given = false

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	local camera = workspace.CurrentCamera
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		-- Пока камера не Scriptable, её каждый кадр двигает стандартный
		-- скрипт, и наши правки не доживают до экрана.
		camera.CameraType = Enum.CameraType.Scriptable
	end
	if cfg.LockMouse and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end

	-- Точка, вокруг которой вертится камера — примерно плечо персонажа.
	local focus = root.Position + Vector3.new(0, cfg.Up, 0)
	local pivot = CFrame.new(focus) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)

	-- Камеру отодвигаем назад и вправо, но НЕ доворачиваем к персонажу: она
	-- смотрит параллельно прицелу. Иначе центр экрана и направление взгляда
	-- разъезжались бы, и целиться стало бы невозможно.
	local wanted = pivot * CFrame.new(cfg.Right, 0, cfg.Distance)

	local position = wanted.Position
	if cfg.Collision and cfg.Distance > 0 then
		-- Упор в стену: между плечом и камерой пускаем луч и, если что-то
		-- есть, придвигаем камеру вплотную к находке.
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		params.IgnoreWater = true

		local step = position - focus
		local hit = workspace:Raycast(focus, step, params)
		if hit then
			position = hit.Position - step.Unit * cfg.Near
		end
	end

	camera.CFrame = CFrame.new(position) * wanted.Rotation
	camera.Focus = CFrame.new(focus)

	-- Персонаж поворачивается за камерой — только вправо-влево. Наклоняться
	-- вперёд-назад ему нечем, для этого и есть поза руки.
	if cfg.TurnBody then
		if humanoid.AutoRotate then
			-- Иначе персонаж доворачивался бы ещё и сам, к направлению бега.
			humanoid.AutoRotate = false
		end
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
	end

	-- Оружие в руках. Пока его нет, рука живёт своей анимацией — это обычное
	-- поведение персонажа, и трогать его незачем.
	local armed = cfg.MoveArm and Core.armed(character)
	if not armed then
		Core.relax(character)
		return
	end

	-- Точка под прицелом — своя на каждый кадр: цель может ехать (враг бежит),
	-- да и сам игрок не стоит на месте.
	local target = Core.target(character, cfg)
	Core.aim(character, target, cfg)

	-- Поза руки считается от угла взгляда ОТНОСИТЕЛЬНО ПЕРСОНАЖА: анимация
	-- размечена в его координатах, а не в мировых.
	local look = root.CFrame:VectorToObjectSpace(camera.CFrame.LookVector)
	Core.pose(character, math.asin(math.clamp(look.Y, -1, 1)), cfg)

	-- Серверу точку шлём 20 раз в секунду и только когда прицел заметно
	-- сдвинулся — глазу хватает, а сеть разгружается. Раз в треть секунды
	-- отправляем в любом случае: цель могла уехать, а прицел — остаться.
	local now = os.clock()
	if now - sentAt > 0.05 then
		local was = (sentAim - root.Position)
		local is = (target - root.Position)
		local moved = was.Magnitude < 0.001 or is.Unit:Dot(was.Unit) < 0.99995
		if moved or now - sentAt > 0.3 then
			sendAim(target)
		end
	end
end

-- Приоритет ровно как у камеры: наш расчёт встаёт на её место в кадре.
RunService:BindToRenderStep("ShoulderCam", Enum.RenderPriority.Camera.Value, update)
