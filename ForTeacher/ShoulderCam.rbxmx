		<Item class="Script" referent="RBX363E25516A254754B9995875590E25CF">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- CamServer — серверная часть модуля наводки (урок 20).
--
-- Script с RunContext = Server: лежит в папке модуля и работает оттуда же.
--
-- Дел у него ровно одно, зато важное: знать, куда целится каждый игрок.
--
-- Камеру сервер не водит — камера у каждого своя. Позу руки он тоже не
-- трогает: анимацию, заигравшую у хозяина персонажа, движок сам показывает
-- остальным игрокам, и рассылать её вручную не нужно.
--
-- А вот точка прицела серверу нужна для дела. Бластер урока 19 проверяет
-- выстрел по СВОЕЙ копии наводки: клиент прислал направление, сервер смотрит,
-- могло ли оружие туда смотреть. Без точки прицела сервер считал бы, что
-- пушка глядит туда, куда её повернула анимация, и разворачивал бы честные
-- выстрелы по-своему.

local Players = game:GetService("Players")

local module = script.Parent
local Core = require(module:WaitForChild("CamCore"))
local aimEvent = module:WaitForChild("Aim")

-- Когда у кого следующий раз примем точку: ограничитель на поток сообщений.
local nextAim = {}

local function watch(player)
	local function ready(character)
		character:WaitForChild("Humanoid", 10)

		-- Оружие убрали: точка прицела больше не нужна.
		character.ChildRemoved:Connect(function(child)
			if child:IsA("Tool") then
				Core.relax(character)
			end
		end)
	end

	player.CharacterAdded:Connect(ready)
	if player.Character then
		task.spawn(ready, player.Character)
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	watch(player)
end
Players.PlayerAdded:Connect(watch)
Players.PlayerRemoving:Connect(function(player)
	nextAim[player] = nil
end)

-- Точку прицела проверяем на разумность: с другого конца карты она развернула
-- бы оружие в никуда, а не-Vector3 уронил бы расчёт.
aimEvent.OnServerEvent:Connect(function(player, target)
	if typeof(target) ~= "Vector3" then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local cfg = Core.config(module)
	if (target - root.Position).Magnitude > cfg.AimRange + 50 then
		return
	end

	local now = os.clock()
	if now < (nextAim[player] or 0) then
		return
	end
	nextAim[player] = now + 0.03

	Core.aim(character, target, cfg)
end)
]]></ProtectedString>
