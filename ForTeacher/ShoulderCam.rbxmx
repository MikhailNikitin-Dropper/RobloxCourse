				<ProtectedString name="Source"><![CDATA[-- CamCore — общая часть модуля наводки (урок 20).
--
-- Модуль подключают оба скрипта: клиент водит камеру и целится, сервер знает
-- точку прицела для проверки выстрелов. Настройки и вся геометрия наводки
-- живут здесь — тогда клиент и сервер точно не разъедутся.
--
-- Устройство взято с оружейного набора Roblox (тот самый, из которого собран
-- AK-12): там ровно эти три приёма, и каждый решает свою беду.
--
--   1. Заряд летит ОТ СРЕЗА СТВОЛА В ТОЧКУ ПОД ПРИЦЕЛОМ. Не «параллельно
--      взгляду» — камера стоит сбоку от персонажа, и параллельный выстрел
--      мажет мимо прицела на эти же пару студов, одинаково вблизи и вдали.
--   2. Руку с оружием держит АНИМАЦИЯ, у которой мы протягиваем время. Не
--      сустав, повёрнутый скриптом: у нового R15 плечо живёт на физике, и
--      любая заигравшая анимация тут же сбивает наведённую руку.
--   3. Хват оружия модуль НЕ ТРОГАЕТ. Как пушка лежит в руке — дело ученика:
--      он ставит Tool.Grip и видит результат. Мы правим только то, куда
--      персонаж смотрит и куда летит заряд.

local Core = {}

-- Настройки лежат в атрибутах самой папки модуля (Properties → Attributes).
-- Здесь только запасные значения: атрибут стёрли или вписали чепуху — модуль
-- всё равно работает.
local NUMBERS = {
	Distance = 10.5,    -- как далеко камера от плеча, студы
	Right = 2.25,       -- сдвиг вправо: камера смотрит из-за ПРАВОГО плеча
	Up = 2.25,          -- высота точки обзора над центром персонажа
	Sensitivity = 0.12, -- градусов на пиксель движения мыши
	MinPitch = -75,     -- насколько низко можно смотреть, градусы
	MaxPitch = 75,      -- и насколько высоко
	AimRange = 400,     -- как далеко ищем точку под прицелом, студы
	Near = 0.6,         -- зазор до стены, в которую упёрлась камера
	AimAnimation = 3972164452, -- анимация «держу оружие и целюсь»
	AimSweep = 80,      -- на сколько градусов вверх и вниз она размечена
	AimLength = 2,      -- и сколько она длится, секунды
}

local FLAGS = {
	Enabled = true,     -- выключатель всего модуля
	TurnBody = true,    -- персонаж поворачивается за камерой
	MoveArm = true,     -- рука держит оружие по анимации наводки
	LockMouse = true,   -- курсор заперт в центре экрана
	Collision = true,   -- камера не проходит сквозь стены
}

function Core.config(root)
	local cfg = {}
	for name, fallback in pairs(NUMBERS) do
		local value = root:GetAttribute(name)
		cfg[name] = typeof(value) == "number" and value or fallback
	end
	for name, fallback in pairs(FLAGS) do
		local value = root:GetAttribute(name)
		cfg[name] = typeof(value) == "boolean" and value or fallback
	end

	-- Границы разумного: отрицательная дальность вывернула бы камеру наизнанку,
	-- а перепутанные пределы взгляда заклинили бы её.
	if cfg.Distance < 0 then
		cfg.Distance = 0
	end
	if cfg.MaxPitch < cfg.MinPitch then
		cfg.MaxPitch = cfg.MinPitch
	end
	if cfg.AimRange < 10 then
		cfg.AimRange = 10
	end
	if cfg.AimSweep < 1 then
		cfg.AimSweep = 1
	end
	return cfg
end

-- --- оружие в руках -------------------------------------------------------

local AIM_POINT = "AimPoint" -- атрибут персонажа: куда целится игрок

-- Оружие в руках. Взятый инструмент лежит прямо в персонаже, рядом с
-- туловищем и руками; пока он в рюкзаке, персонаж его не держит.
function Core.armed(character)
	return character and character:FindFirstChildOfClass("Tool") or nil
end

-- Точка, куда целится игрок: что лежит под прицелом. Луч пускаем от камеры
-- через центр экрана — там и заперт курсор.
function Core.target(character, cfg)
	local eye = workspace.CurrentCamera.CFrame
	local range = cfg and cfg.AimRange or NUMBERS.AimRange

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true

	-- Луч начинаем не от самой камеры, а от точки ПЕРЕД персонажем. Камера
	-- стоит в десяти студах позади, и без этого прицел цеплялся бы за то, что
	-- лежит между ней и игроком: за угол, из-за которого он выглядывает, за
	-- пол под ногами. Точка прицела оказывалась бы у персонажа за спиной.
	local root = character:FindFirstChild("HumanoidRootPart")
	local ahead = 0
	if root then
		ahead = math.max((root.Position - eye.Position):Dot(eye.LookVector) + 4, 0)
	end

	local from = eye.Position + eye.LookVector * ahead
	local hit = workspace:Raycast(from, eye.LookVector * range, params)
	return hit and hit.Position or from + eye.LookVector * range
end

-- --- рука ------------------------------------------------------------------

-- Руку с оружием держит АНИМАЦИЯ — та же, что в оружейном наборе Roblox.
--
-- Приём в ней такой. Анимация длиной в две секунды размечена как разворот
-- прицела: в самом начале персонаж целится вниз на 80°, в самом конце — вверх
-- на 80°, между ними всё промежуточное. Играть её не даём вовсе (скорость
-- почти ноль), а вместо этого сами ставим время внутри неё по углу взгляда.
-- Получается не «проигранная анимация», а поза, которой управляют как ручкой.
--
-- Почему не поворот сустава скриптом: у новых аватаров R15 суставов Motor6D
-- нет, рука висит на физике, и всё, что мы ей приказали, тут же затирает
-- заигравшая анимация покоя. А одна анимация другую не сбивает — движок
-- смешивает их сам, по старшинству.
local TRACKS = setmetatable({}, { __mode = "k" }) -- на каждого персонажа своя

function Core.track(character, cfg)
	local ready = TRACKS[character]
	if ready then
		return ready
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return nil
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. math.floor(cfg.AimAnimation)

	local track = animator:LoadAnimation(anim)
	track.Priority = Enum.AnimationPriority.Action -- поверх ходьбы и покоя
	track.Looped = false
	TRACKS[character] = track
	return track
end

-- --- наводка ---------------------------------------------------------------

-- Навести оружие в точку. Зовёт её клиент каждый кадр: он один знает, куда
-- смотрит камера. Серверу точка приезжает событием — ему она нужна, чтобы
-- проверять выстрелы.
function Core.aim(character, target, cfg)
	if typeof(target) ~= "Vector3" then
		return
	end
	local tool = Core.armed(character)
	if not tool then
		Core.relax(character)
		return
	end

	-- Оружие и выстрел общаются через этот атрибут: бластер урока 19 сам
	-- заглядывает в него и, если точка есть, стреляет из среза ствола в неё
	-- вместо своего ствола. Никаких общих модулей между уроками не нужно.
	--
	-- Сам Tool мы не трогаем ВООБЩЕ. Раньше модуль доворачивал хват каждый
	-- кадр, чтобы ствол смотрел точно в прицел, — и этим стирал хват, который
	-- настроил ученик: менять Grip в Properties становилось бессмысленно.
	-- Заряд и так летит куда надо, а как пушка лежит в руке — дело ученика.
	character:SetAttribute(AIM_POINT, target)
end

-- Поза руки по углу взгляда. Только у себя: анимацию, заигравшую у хозяина
-- персонажа, движок сам показывает остальным игрокам.
function Core.pose(character, angle, cfg)
	local track = Core.track(character, cfg)
	if not track then
		return
	end
	if not track.IsPlaying then
		track:Play(0.15)
	end
	track:AdjustSpeed(0.001) -- почти стоп: время в анимации ставим сами

	local sweep = math.rad(cfg.AimSweep)
	local part = math.clamp((angle + sweep) / (2 * sweep), 0, 1)
	local length = cfg.AimLength
	track.TimePosition = math.clamp(part * length, 0.001, length - 0.03)
end

-- Отпустить руку: оружия нет — персонаж двигается своими анимациями.
function Core.relax(character)
	if not character then
		return
	end
	character:SetAttribute(AIM_POINT, nil)

	local track = TRACKS[character]
	if track and track.IsPlaying then
		track:Stop(0.15)
	end
end

return Core
]]></ProtectedString>
