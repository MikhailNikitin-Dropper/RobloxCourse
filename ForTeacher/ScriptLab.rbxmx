		<Item class="Script" referent="RBXB172871989CB41B7AE1616B91B798200">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- BlinkScript — заставляет деталь мигать светом. Модуль курса «Лаборатория
-- скриптов», урок 29.
--
-- КАК ЧИТАТЬ ЭТОТ ФАЙЛ. Между двумя рядами знаков «равно» ниже лежат
-- настройки: имя детали и три числа. Их можно менять. Всё, что ниже второго
-- ряда, — логика: её не трогаем.
--
-- Свет модуль добавляет сам, если его в детали ещё нет.

-- ============================ НАСТРОЙКИ ============================
local PART = "Blinker" -- имя детали-маяка (в кавычках!)
local EVERY = 0.8 -- как часто мигает: раз в столько секунд
local RANGE = 12 -- далеко ли видно свет, в студах
local BRIGHT = 2 -- насколько ярко светит
-- ===================================================================

-- Папка модуля лежит внутри модели, поэтому деталь ищем в ней.
local model = script.Parent.Parent
local part = model:FindFirstChild(PART)

if not part then
	return
end

local light = part:FindFirstChildOfClass("PointLight")
if not light then
	light = Instance.new("PointLight")
	light.Color = part.Color
	light.Parent = part
end

light.Range = RANGE
light.Brightness = BRIGHT

while true do
	light.Enabled = not light.Enabled
	part.Material = light.Enabled and Enum.Material.Neon or Enum.Material.SmoothPlastic
	task.wait(EVERY)
end
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<token name="RunContext">1</token>
				<string name="Name">BlinkScript</string>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXCAEB517BE6D34DF398006E7D200AE98D">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- LiftScript — лифт: сам поднимает площадку вверх и опускает обратно.
-- Модуль курса «Лаборатория скриптов», урок 29.
--
-- КАК ЧИТАТЬ ЭТОТ ФАЙЛ. Между двумя рядами знаков «равно» ниже лежат
-- настройки: имя детали и три числа. Их можно менять. Всё, что ниже второго
-- ряда, — логика: её не трогаем.
--
-- Числа с точкой писать через точку, а не через запятую: 1.5, а не 1,5.

-- ============================ НАСТРОЙКИ ============================
local PART = "Lift" -- имя детали-площадки (в кавычках!)
local HEIGHT = 11 -- на сколько студов поднимается
local SECONDS = 3 -- сколько секунд едет в одну сторону
local PAUSE = 1.5 -- сколько секунд стоит на месте наверху и внизу
-- ===================================================================

local RunService = game:GetService("RunService")

-- Папка модуля лежит внутри модели, поэтому деталь ищем в ней.
local model = script.Parent.Parent
local part = model:FindFirstChild(PART)

if not part then
	return
end

part.Anchored = true

local bottom = part.CFrame
local top = bottom + Vector3.new(0, HEIGHT, 0)

-- Проехать из одной точки в другую за SECONDS секунд. Площадка двигается
-- маленькими шагами каждый кадр, поэтому игрок едет вместе с ней.
local function travel(from, to)
	local passed = 0
	while passed < SECONDS do
		passed = passed + RunService.Heartbeat:Wait()
		part.CFrame = from:Lerp(to, math.clamp(passed / SECONDS, 0, 1))
	end
	part.CFrame = to
end

while true do
	travel(bottom, top)
	task.wait(PAUSE)
	travel(top, bottom)
	task.wait(PAUSE)
end
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<token name="RunContext">1</token>
				<string name="Name">LiftScript</string>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXEF6D1ED5C95945FE9B0DA7B9DCF38C9A">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- GhostScript — мост-призрак: то держит игрока, то пропускает его насквозь.
-- Модуль курса «Лаборатория скриптов», урок 29.
--
-- КАК ЧИТАТЬ ЭТОТ ФАЙЛ. Между двумя рядами знаков «равно» ниже лежат
-- настройки: имя детали и четыре числа. Их можно менять. Всё, что ниже второго
-- ряда, — логика: её не трогаем.
--
-- ПОРЯДОК ВАЖЕН: мост тает раньше, чем перестаёт держать, и снова держит
-- раньше, чем становится плотным. Пока он выглядит плотным — на него можно
-- вставать. Прозрачным он всё равно остаётся видимым: это правило курса.

-- ============================ НАСТРОЙКИ ============================
local PART = "Ghost" -- имя детали-моста (в кавычках!)
local SOLID = 3 -- сколько секунд мост стоит плотным
local GHOST = 2 -- сколько секунд он пропускает насквозь
local FADE = 0.7 -- насколько призрак прозрачный: от 0 до 0.9
local TRANSITION = 0.5 -- сколько секунд занимает таяние и возврат
-- ===================================================================

local TweenService = game:GetService("TweenService")

-- Папка модуля лежит внутри модели, поэтому деталь ищем в ней.
local model = script.Parent.Parent
local part = model:FindFirstChild(PART)

if not part then
	return
end

part.Anchored = true

-- Полностью невидимым мост не станет, даже если вписать единицу.
local fade = math.clamp(FADE, 0, 0.9)

-- Таем без ускорений: так по мосту видно, сколько осталось.
local smooth = TweenInfo.new(TRANSITION, Enum.EasingStyle.Linear)

while true do
	-- плотный мост: держит
	part.CanCollide = true
	part.Transparency = 0
	task.wait(SOLID)

	-- предупреждение: тает на глазах, но пока ещё держит
	TweenService:Create(part, smooth, { Transparency = fade }):Play()
	task.wait(TRANSITION)

	-- призрак: видно, но насквозь
	part.CanCollide = false
	task.wait(GHOST)

	-- возврат: сначала опора, потом плотность
	part.CanCollide = true
	TweenService:Create(part, smooth, { Transparency = 0 }):Play()
	task.wait(TRANSITION)
end
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<token name="RunContext">1</token>
				<string name="Name">GhostScript</string>
			</Properties>
		</Item>
	</Item>
</roblox>
