<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="Folder" referent="RBXC28D47DC235F468B9B7D2AB0F333AE6C">
		<Properties>
			<string name="Name">EscapeTimer</string>
		</Properties>
		<Item class="Script" referent="RBXB84055DB700747A5BE6F7F2D1BA7DDE0">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- EscapeTimerScript — настенный дисплей с обратным отсчётом.
-- Модуль курса «Таймер побега», урок 31.
--
-- КАК ЧИТАТЬ ЭТОТ ФАЙЛ. Между двумя рядами знаков «равно» ниже лежат
-- настройки: сколько секунд идёт отсчёт, что написано в конце и на какой грани
-- детали появятся цифры. Их можно менять. Всё, что ниже второго ряда, —
-- логика: её не трогаем.
--
-- Папка модуля кладётся внутрь детали-дисплея. Скрипт сам рисует на её грани
-- дисплей с цифрами: отдельно собирать интерфейс не нужно.
--
-- Время вышло — штраф: все игроки возвращаются на точку возрождения, двери
-- модулей «Кнопка и дверь» и «Ключ и замок» закрываются, ключи ложатся на
-- свои места, и отсчёт начинается заново. Встал на финиш — таймер замирает.

-- ============================ НАСТРОЙКИ ============================
local SECONDS = 300 -- сколько секунд на побег: 300 — это 5 минут
local TIME_UP_TEXT = "Время вышло" -- что написано на дисплее, когда время кончилось
local FACE = "Front" -- грань детали с цифрами: Front, Back, Left, Right, Top, Bottom
local WARN_SECONDS = 30 -- за сколько секунд до конца цифры краснеют; 0 — не краснеют
local RESTART = true -- true — время вышло: все на старт и заново; false — без штрафа
local RESTART_DELAY = 3 -- сколько секунд висит надпись, прежде чем всё начнётся заново
local FINISH = "ExitPad" -- имя детали финиша: встал на неё — таймер останавливается
local WIN_TEXT = "Побег удался" -- что написано на дисплее, когда игрок на финише
-- ===================================================================

local Players = game:GetService("Players")

-- Папка модуля лежит внутри детали-дисплея.
local board = script.Parent.Parent

if not board:IsA("BasePart") then
	warn("EscapeTimer: папку модуля кладут внутрь детали-дисплея, а не в модель")
	return
end

board.Anchored = true

-- Дисплей: SurfaceGui на грани детали. LightInfluence 0 — цифры видно и в темноте.
local gui = board:FindFirstChild("EscapeTimerGui")
if not gui then
	gui = Instance.new("SurfaceGui")
	gui.Name = "EscapeTimerGui"
	gui.Parent = board
end
gui.Face = Enum.NormalId[FACE] or Enum.NormalId.Front
gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
gui.PixelsPerStud = 50
gui.LightInfluence = 0
gui.AlwaysOnTop = false

local label = gui:FindFirstChild("Time")
if not label then
	label = Instance.new("TextLabel")
	label.Name = "Time"
	label.Parent = gui
end
label.Size = UDim2.fromScale(1, 1)
label.BackgroundTransparency = 1
label.Font = Enum.Font.GothamBold
label.TextScaled = true
label.TextColor3 = Color3.fromRGB(255, 255, 255)
label.Text = "--:--"

local function show(seconds)
	local minutes = math.floor(seconds / 60)
	local rest = seconds % 60
	label.Text = string.format("%02d:%02d", minutes, rest)
	if WARN_SECONDS > 0 and seconds <= WARN_SECONDS then
		label.TextColor3 = Color3.fromRGB(255, 80, 70)
	else
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end

-- Финиш: деталь с именем FINISH где угодно в Workspace. Нет такой детали —
-- таймер просто идёт до конца.
local escaped = false
local finish = FINISH ~= "" and workspace:FindFirstChild(FINISH, true)
if finish and finish:IsA("BasePart") then
	finish.Touched:Connect(function(hit)
		local character = hit.Parent
		if not escaped and character and Players:GetPlayerFromCharacter(character) then
			escaped = true
			label.Text = WIN_TEXT
			label.TextColor3 = Color3.fromRGB(110, 230, 120)
		end
	end)
end

-- Отсчёт идёт с первой секунды игры. Атрибут Seconds виден в Properties: по
-- нему другие модули урока могут понять, сколько осталось.
local total = math.max(0, math.floor(SECONDS))

task.spawn(function()
	while true do
		local left = total
		board:SetAttribute("Seconds", left)
		show(left)
		while left > 0 and not escaped do
			task.wait(1)
			if escaped then
				break
			end
			left -= 1
			board:SetAttribute("Seconds", left)
			show(left)
		end
		if escaped then
			return
		end
		label.Text = TIME_UP_TEXT
		label.TextColor3 = Color3.fromRGB(255, 80, 70)
		if not RESTART then
			return
		end
		task.wait(RESTART_DELAY)
		-- Сигнал остальным модулям побега: закрыть двери, вернуть ключи.
		workspace:SetAttribute("EscapeRound", (workspace:GetAttribute("EscapeRound") or 0) + 1)
		-- Новый персонаж появляется на точке возрождения с пустым рюкзаком.
		for _, player in ipairs(Players:GetPlayers()) do
			player:LoadCharacter()
		end
	end
end)
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<token name="RunContext">1</token>
				<string name="Name">EscapeTimerScript</string>
			</Properties>
		</Item>
	</Item>
</roblox>
