<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="Folder" referent="RBXF8351F458EAF4DB0869709308AA3C23F">
		<Properties>
			<string name="Name">ShopKiosk</string>
		</Properties>
		<Item class="RemoteEvent" referent="RBX46EE9E4FD56A4840B8CF5177BBD4DE06">
			<Properties>
				<string name="Name">Open</string>
			</Properties>
		</Item>
		<Item class="RemoteEvent" referent="RBX38DD0A1527134651BD9DA8049209F91C">
			<Properties>
				<string name="Name">Buy</string>
			</Properties>
