			<Properties>
				<string name="Name">ShopItems</string>
			</Properties>
			<Item class="Tool" referent="RBXEA909EDB0F20490C842ABCF6AEBFF804">
				<Properties>
					<string name="Name">Аптечка</string>
					<string name="ToolTip">Нажми, чтобы использовать</string>
					<bool name="CanBeDropped">false</bool>
					<bool name="RequiresHandle">true</bool>
					<BinaryString name="AttributesSerialize">AwAAAAUAAABQcmljZQYAAAAAAABEQAUAAABPcmRlcgYAAAAAAADwPwsAAABEZXNjcmlwdGlvbgIvAAAA0JvQtdGH0LjRgiDQtNC+INC/0L7Qu9C90L7Qs9C+INC30LTQvtGA0L7QstGM0Y8=</BinaryString>
				</Properties>
				<Item class="Part" referent="RBX062FB9E9ADB941018E459C12CC609994">
					<Properties>
						<bool name="Anchored">false</bool>
						<bool name="CanCollide">false</bool>
						<bool name="Massless">true</bool>
						<CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
						<Color3uint8 name="Color3uint8">4293609030</Color3uint8>
						<token name="Material">272</token>
						<token name="TopSurface">0</token>
						<token name="BottomSurface">0</token>
						<token name="shape">1</token>
						<Vector3 name="size"><X>1</X><Y>1</Y><Z>1</Z></Vector3>
						<string name="Name">Handle</string>
					</Properties>
					<Item class="Weld" referent="RBXF08F5AFEC0C24692B62BB955EC8E202A">
