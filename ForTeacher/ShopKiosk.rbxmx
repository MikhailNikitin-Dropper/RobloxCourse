			<Item class="Script" referent="RBX4654F968513E47B7AD0F1D67332E65E1">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Большой рюкзак — товар магазина. Взял в руку, нажал — в рюкзаке больше
-- мест до гибели. Места прибавляет модуль лута по атрибуту игрока BonusSlots.
-- Скрипт кладут внутрь Tool-товара, который собирают сами: деталь Handle
-- и любая модель вокруг неё. Цена — атрибут Price у этого Tool
-- (Properties → Attributes), строка на карточке магазина — атрибут
-- Description. В плейсе курса: Price = 80, Description = «+3 места до гибели».

-- ============================ НАСТРОЙКИ ============================
local EXTRA_SLOTS = 3 -- сколько мест добавить
-- ===================================================================

local Players = game:GetService("Players")
local tool = script.Parent

-- Пока скрипт лежит в папке ShopItems, а не внутри Tool, он ничего не делает.
if not tool:IsA("Tool") then
	return
end

local function say(player, text)
	local notice = game:GetService("ReplicatedStorage"):FindFirstChild("ShopNotice")
	if notice then
		notice:FireClient(player, text)
	end
end

tool.Activated:Connect(function()
	local character = tool.Parent
	local player = Players:GetPlayerFromCharacter(character)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (player and humanoid and humanoid.Health > 0) then
		return
	end
	-- В бункере и под защитным полем предметы не действуют: атрибут игрока
	-- InRaid ставит модуль рейда, когда поле после входа снято.
	if not player:GetAttribute("InRaid") then
		say(player, "Работает только на вылазке")
		return
	end
	if (player:GetAttribute("BonusSlots") or 0) > 0 then
		say(player, "Большой рюкзак уже надет")
		return
	end
	player:SetAttribute("BonusSlots", EXTRA_SLOTS)
	tool:Destroy()
end)
]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<token name="RunContext">1</token>
					<string name="Name">Большой рюкзак</string>
				</Properties>
			</Item>
