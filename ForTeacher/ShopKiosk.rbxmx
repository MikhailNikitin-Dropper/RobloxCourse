				<Item class="Script" referent="RBXA7F244028CAB4D9095CD48E9BB5FC365">
					<Properties>
						<ProtectedString name="Source"><![CDATA[-- Большой рюкзак — товар магазина. Взял в руку, нажал — в рюкзаке больше
		-- мест до гибели. Места прибавляет модуль лута по атрибуту игрока BonusSlots.
		-- Цена — атрибут Price у самого предмета (Properties → Attributes).
		
		-- ============================ НАСТРОЙКИ ============================
		local EXTRA_SLOTS = 3 -- сколько мест добавить
		-- ===================================================================
		
		local Players = game:GetService("Players")
		local tool = script.Parent
		
		local function say(player, text)
			local notice = game:GetService("ReplicatedStorage"):FindFirstChild("ShopNotice")
			if notice then
				notice:FireClient(player, text)
			end
		end
		
		tool.Activated:Connect(function()
			local character = tool.Parent
			local player = Players:GetPlayerFromCharacter(character)
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not (player and humanoid and humanoid.Health > 0) then
				return
			end
			-- В бункере и под защитным полем предметы не действуют: атрибут игрока
			-- InRaid ставит модуль рейда, когда поле после входа снято.
			if not player:GetAttribute("InRaid") then
				say(player, "Работает только на вылазке")
				return
			end
			if (player:GetAttribute("BonusSlots") or 0) > 0 then
				say(player, "Большой рюкзак уже надет")
				return
			end
			player:SetAttribute("BonusSlots", EXTRA_SLOTS)
			tool:Destroy()
		end)
		]]></ProtectedString>
