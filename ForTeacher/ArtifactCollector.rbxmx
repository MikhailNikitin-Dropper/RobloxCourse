<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="Folder" referent="RBXF78C265A4DA14B29BA8935A46B54D36D">
		<Properties>
			<string name="Name">ArtifactCollector</string>
		</Properties>
		<Item class="RemoteEvent" referent="RBXE676DD7BE2D84AA48A77FBBEBAB9DFBB">
			<Properties>
				<string name="Name">Collected</string>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX5271154231684B8D8CDB20B2CB522334">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Модуль курса «Артефакты» (ArtifactCollector) — серверная часть, урок 28.
--
-- Что делает: считает артефакты, собранные игроком, и сообщает его экрану
-- о каждой находке. Больше ничего: деталей не строит, мир не меняет.
--
-- Артефакт — это ЛЮБАЯ закреплённая деталь с тегом Artifact ИЛИ целая модель
-- с этим тегом: артефакт редко бывает одним кубиком, обычно это кристалл с
-- подставкой и свечением. Внутри артефакта может лежать StringValue — записка,
-- её текст игрок увидит в момент находки.
--
-- ДОМАШНЕЕ МЕСТО АРТЕФАКТА СЕРВЕР ЗАПИСЫВАЕТ В АТРИБУТ ArtifactHome. Экранная
-- часть покачивает артефакт и потому обязана знать, откуда его качать, — но
-- спрашивать место у самой модели она не может. При включённом
-- Workspace.StreamingEnabled модель приезжает клиенту РАНЬШЕ своих деталей, и
-- GetPivot() у пустой ещё модели отдаёт нули; клиент запоминал этот ноль как
-- «дом» и тащил артефакт в начало координат. Отсюда были две беды сразу:
-- артефакты пропадали из лабиринта и переставали засчитываться (деталь, по
-- которой клиент считает касания, лежала за сто студов от игрока). Сервер
-- видит мир целиком, поэтому место пишет он — один раз, в атрибут.
--
-- НАХОДКА ЗАСЧИТЫВАЕТСЯ ПО РАССТОЯНИЮ, А НЕ ПО КАСАНИЮ (Touched). Проверка
-- расстояния на сервере не зависит ни от стриминга, ни от того, что клиент
-- делает с видом артефакта: раз в PICKUP_STEP секунд модуль сравнивает
-- позицию игрока с позицией артефакта. Замер 09.09.2026 показал, насколько
-- это важнее: пока клиент держал артефакт не на месте, Touched не срабатывал
-- вообще — ни у модуля, ни у пробника, повешенного руками.
--
-- НАСТРОЙКИ — атрибуты на самой папке модуля (заводить руками не нужно):
--   PickupRange  5   с какого расстояния артефакт считается найденным
--
-- Счёт у каждого игрока свой: гость, зашедший в игру позже хозяина, собирает
-- артефакты сам, чужие находки его счётчик не трогают. Число собранного
-- записывается игроку в атрибут Artifacts — по нему выход находит тех, кому
-- уже можно открыть портал (модуль «Портал», урок 28).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local TAG = "Artifact"

local folder = script.Parent
local collected = folder:WaitForChild("Collected")

local DEFAULTS = { PickupRange = 5 }
for name, value in pairs(DEFAULTS) do
	if folder:GetAttribute(name) == nil then
		folder:SetAttribute(name, value)
	end
end

local function setting(name)
	local value = folder:GetAttribute(name)
	if value == nil then
		return DEFAULTS[name]
	end
	return value
end

local PICKUP_STEP = 0.2 -- как часто сервер сверяет расстояния

local taken = {} -- [Player] = { [деталь] = true }
local count = {} -- [Player] = сколько артефактов собрано

-- Артефактом считаем и деталь, и модель — лишь бы стояла в Workspace.
local function isArtifact(item)
	return (item:IsA("BasePart") or item:IsA("Model")) and item:IsDescendantOf(workspace)
end

local function total()
	local n = 0
	for _, item in ipairs(CollectionService:GetTagged(TAG)) do
		if isArtifact(item) then
			n = n + 1
		end
	end
	return n
end

local function noteOf(item)
	local value = item:FindFirstChildWhichIsA("StringValue", true)
	return value and value.Value or ""
end

local function collect(player, item)
	local mine = taken[player]
	if not mine or mine[item] then
		return
	end
	mine[item] = true
	count[player] = count[player] + 1
	-- Атрибут игрока: по нему артефакты видит любой другой скрипт в игре —
	-- портал-выход, финальная награда.
	player:SetAttribute("Artifacts", count[player])
	collected:FireClient(player, item, item.Name, noteOf(item), count[player], total())
end

-- Где находится артефакт. Сначала записанный дом, потом уже сама модель:
-- дом не сдвинется, даже если артефакт кто-то анимирует.
local function positionOf(item)
	local home = item:GetAttribute("ArtifactHome")
	if typeof(home) == "CFrame" then
		return home.Position
	end
	if item:IsA("Model") then
		local ok, pivot = pcall(function()
			return item:GetPivot()
		end)
		return ok and pivot.Position or nil
	end
	return item.Position
end

local HOME_ATTRIBUTE = "ArtifactHome"

-- Где артефакт стоит на самом деле. Записываем один раз: дальше это правда
-- и для экранной части, и для нас самих.
local function rememberHome(item)
	if item:GetAttribute(HOME_ATTRIBUTE) ~= nil then
		return
	end
	local ok, place = pcall(function()
		if item:IsA("Model") then
			return item:GetPivot()
		end
		return item.CFrame
	end)
	if ok and typeof(place) == "CFrame" then
		item:SetAttribute(HOME_ATTRIBUTE, place)
	end
end

-- Артефакт — награда, а не стена: сквозь него проходят.
local function prepare(item)
	if not isArtifact(item) then
		return
	end
	rememberHome(item)
	if item:IsA("BasePart") then
		item.CanCollide = false
		return
	end
	for _, child in ipairs(item:GetDescendants()) do
		if child:IsA("BasePart") then
			child.CanCollide = false
		end
	end
end

for _, item in ipairs(CollectionService:GetTagged(TAG)) do
	prepare(item)
end
CollectionService:GetInstanceAddedSignal(TAG):Connect(prepare)

-- Главный цикл: подошёл ближе PickupRange — артефакт твой.
task.spawn(function()
	while true do
		task.wait(PICKUP_STEP)
		local range = setting("PickupRange")
		for _, player in ipairs(Players:GetPlayers()) do
			local mine = taken[player]
			local character = player.Character
			local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if mine and root and humanoid and humanoid.Health > 0 then
				for _, item in ipairs(CollectionService:GetTagged(TAG)) do
					if not mine[item] and isArtifact(item) then
						local pos = positionOf(item)
						if pos and (pos - root.Position).Magnitude <= range then
							collect(player, item)
						end
					end
				end
			end
		end
	end
end)

local function ready(player)
	taken[player] = taken[player] or {}
	count[player] = count[player] or 0
	-- Пустая находка: экран просто узнаёт, сколько артефактов в лабиринте всего.
	collected:FireClient(player, nil, "", "", count[player], total())
end

Players.PlayerAdded:Connect(function(player)
	player:SetAttribute("Artifacts", 0)
	ready(player)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		ready(player)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	taken[player] = nil
	count[player] = nil
end)

for _, player in ipairs(Players:GetPlayers()) do
	ready(player)
end
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<token name="RunContext">1</token>
				<string name="Name">ArtifactServer</string>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX10619463DB954DF1B22A251107AF93E3">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Модуль курса «Артефакты» (ArtifactCollector) — экранная часть, урок 28.
--
-- Что делает: показывает находку тем же уведомлением, которым Roblox
-- показывает свои собственные («друг зашёл в игру», «получен значок»),
-- держит счётчик артефактов вверху экрана и разыгрывает саму находку —
-- артефакт подпрыгивает, закручивается, уменьшается и улетает к игроку.
--
-- Всё это происходит только на экране игрока: артефакт, который забрал один
-- игрок, остальные по-прежнему видят на месте.
--
-- ПОЧЕМУ УВЕДОМЛЕНИЕ РОДНОЕ, А НЕ СВОЁ. StarterGui:SetCore("SendNotification")
-- рисует настоящую панель Roblox — ту же, что и системные сообщения игры.
-- Своя панель, как её ни крась, выглядит наклейкой поверх чужого интерфейса;
-- родная сама встаёт на нужное место, сама держит стиль и сама выстраивает
-- очередь, если находок сразу несколько. Если вызов почему-то не сработал
-- (старая сборка клиента), включается запасная плашка — собранная в той же
-- манере: чёрный полупрозрачный прямоугольник со скруглением 8 и шрифтом
-- Builder Sans, как панели Roblox.
--
-- Артефактом может быть и одна деталь, и целая модель (кристалл с подставкой
-- и свечением) — модуль работает с обоими: у модели двигается пивот, у детали
-- CFrame.
--
-- ОТКУДА ЭКРАН ЗНАЕТ, ГДЕ АРТЕФАКТ СТОИТ. Из атрибута ArtifactHome, который
-- пишет серверная часть, а НЕ из GetPivot самой модели. При включённом
-- Workspace.StreamingEnabled модель приезжает клиенту раньше своих деталей, и
-- пивот пустой модели равен нулю; запомнив этот ноль как «дом», покачивание
-- утаскивало артефакт в начало координат — он пропадал из лабиринта и
-- переставал засчитываться. Пока атрибута нет, артефакт не трогаем вовсе.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local TAG = "Artifact"

local folder = script.Parent
local collected = folder:WaitForChild("Collected")

local player = Players.LocalPlayer
while not player do
	task.wait()
	player = Players.LocalPlayer
end

-- ЭКРАН ---------------------------------------------------------------------

-- Builder Sans — системный шрифт интерфейсов Roblox. Если сборка Studio его
-- ещё не знает, откатываемся на Gotham: он стоял в интерфейсах до него.
local function fontOf(names)
	for _, name in ipairs(names) do
		local ok, value = pcall(function()
			return Enum.Font[name]
		end)
		if ok and value then
			return value
		end
	end
	return Enum.Font.SourceSans
end

local FONT_BOLD = fontOf({ "BuilderSansBold", "GothamBold" })
local FONT_TEXT = fontOf({ "BuilderSansMedium", "GothamMedium", "Gotham" })

-- Числа взяты с собственных панелей Roblox: чёрный фон на половину
-- прозрачности, скругление 8, тонкая белая обводка почти в ноль видимости.
local PANEL = Color3.fromRGB(0, 0, 0)
local PANEL_TRANSPARENCY = 0.45
local TEXT = Color3.fromRGB(255, 255, 255)
local MUTED = Color3.fromRGB(200, 203, 209)
local ACCENT = Color3.fromRGB(120, 220, 255)

local gui = Instance.new("ScreenGui")
gui.Name = "ArtifactGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(object, radius)
	local item = Instance.new("UICorner")
	item.CornerRadius = UDim.new(0, radius)
	item.Parent = object
end

local function stroke(object)
	local line = Instance.new("UIStroke")
	line.Color = Color3.fromRGB(255, 255, 255)
	line.Transparency = 0.88
	line.Thickness = 1
	line.Parent = object
end

-- СЧЁТЧИК. Своего счётчика у Roblox нет, поэтому рисуем сами — но ровно в том
-- же виде, что его панели: тёмная плашка, серая подпись, белое число.
local counter = Instance.new("Frame")
counter.Name = "Counter"
counter.AnchorPoint = Vector2.new(0.5, 0)
counter.Position = UDim2.new(0.5, 0, 0, 10)
counter.Size = UDim2.new(0, 168, 0, 40)
counter.BackgroundColor3 = PANEL
counter.BackgroundTransparency = PANEL_TRANSPARENCY
counter.BorderSizePixel = 0
counter.Parent = gui
corner(counter, 8)
stroke(counter)

local counterName = Instance.new("TextLabel")
counterName.Name = "Label"
counterName.BackgroundTransparency = 1
counterName.Position = UDim2.new(0, 14, 0, 0)
counterName.Size = UDim2.new(0, 70, 0, 32)
counterName.Font = FONT_TEXT
counterName.TextColor3 = MUTED
counterName.TextSize = 15
counterName.TextXAlignment = Enum.TextXAlignment.Left
counterName.Text = "Артефакты"
counterName.Parent = counter

local counterValue = Instance.new("TextLabel")
counterValue.Name = "Value"
counterValue.AnchorPoint = Vector2.new(1, 0)
counterValue.BackgroundTransparency = 1
counterValue.Position = UDim2.new(1, -14, 0, 0)
counterValue.Size = UDim2.new(0, 70, 0, 32)
counterValue.Font = FONT_BOLD
counterValue.TextColor3 = TEXT
counterValue.TextSize = 19
counterValue.TextXAlignment = Enum.TextXAlignment.Right
counterValue.Text = "0 / 0"
counterValue.Parent = counter

local track = Instance.new("Frame")
track.Name = "Track"
track.AnchorPoint = Vector2.new(0.5, 1)
track.Position = UDim2.new(0.5, 0, 1, -7)
track.Size = UDim2.new(1, -28, 0, 3)
track.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
track.BackgroundTransparency = 0.75
track.BorderSizePixel = 0
track.Parent = counter
corner(track, 2)

local fill = Instance.new("Frame")
fill.Name = "Fill"
fill.Size = UDim2.new(0, 0, 1, 0)
fill.BackgroundColor3 = ACCENT
fill.BorderSizePixel = 0
fill.Parent = track
corner(fill, 2)

-- ЗАПАСНАЯ ПЛАШКА. Нужна, только если родное уведомление не отозвалось.
local toast = Instance.new("Frame")
toast.Name = "Fallback"
toast.AnchorPoint = Vector2.new(1, 1)
toast.Position = UDim2.new(1, -16, 1, -16)
toast.Size = UDim2.new(0, 300, 0, 84)
toast.BackgroundColor3 = PANEL
toast.BackgroundTransparency = PANEL_TRANSPARENCY
toast.BorderSizePixel = 0
toast.Visible = false
toast.Parent = gui
corner(toast, 8)
stroke(toast)

local toastTitle = Instance.new("TextLabel")
toastTitle.BackgroundTransparency = 1
toastTitle.Position = UDim2.new(0, 14, 0, 10)
toastTitle.Size = UDim2.new(1, -28, 0, 22)
toastTitle.Font = FONT_BOLD
toastTitle.TextColor3 = TEXT
toastTitle.TextSize = 17
toastTitle.TextXAlignment = Enum.TextXAlignment.Left
toastTitle.Text = ""
toastTitle.Parent = toast

local toastText = Instance.new("TextLabel")
toastText.BackgroundTransparency = 1
toastText.Position = UDim2.new(0, 14, 0, 32)
toastText.Size = UDim2.new(1, -28, 0, 42)
toastText.Font = FONT_TEXT
toastText.TextColor3 = MUTED
toastText.TextSize = 15
toastText.TextWrapped = true
toastText.TextXAlignment = Enum.TextXAlignment.Left
toastText.TextYAlignment = Enum.TextYAlignment.Top
toastText.Text = ""
toastText.Parent = toast

local toastToken = 0

local function showFallback(title, text, seconds)
	toastToken = toastToken + 1
	local token = toastToken
	toastTitle.Text = title
	toastText.Text = text
	toast.Visible = true
	task.delay(seconds, function()
		if token == toastToken then
			toast.Visible = false
		end
	end)
end

-- Родное уведомление Roblox.
local function notify(title, text, seconds)
	local ok = pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = seconds,
		})
	end)
	if not ok then
		showFallback(title, text, seconds)
	end
end

local SLOW = TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function setCount(mine, all)
	counterValue.Text = string.format("%d / %d", mine, all)
	local share = all > 0 and math.clamp(mine / all, 0, 1) or 0
	TweenService:Create(fill, SLOW, { Size = UDim2.new(share, 0, 1, 0) }):Play()
end

local function bumpCounter()
	counterValue.TextSize = 23
	TweenService:Create(counterValue, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		TextSize = 19,
	}):Play()
end

-- САМИ АРТЕФАКТЫ -------------------------------------------------------------
-- Артефакт — деталь или модель. Разница ровно в трёх действиях (взять пивот,
-- поставить пивот, перебрать детали), дальше код один и тот же.

local function isArtifact(item)
	return item ~= nil and (item:IsA("BasePart") or item:IsA("Model"))
end

local function pivotOf(item)
	if item:IsA("Model") then
		return item:GetPivot()
	end
	return item.CFrame
end

local function setPivot(item, cframe)
	if item:IsA("Model") then
		item:PivotTo(cframe)
	else
		item.CFrame = cframe
	end
end

local function partsOf(item)
	if item:IsA("BasePart") then
		return { item }
	end
	local list = {}
	for _, child in ipairs(item:GetDescendants()) do
		if child:IsA("BasePart") then
			table.insert(list, child)
		end
	end
	return list
end

local HOME_ATTRIBUTE = "ArtifactHome"

-- Дом артефакта: только то, что записал сервер. Своей догадке про место
-- доверять нельзя — см. шапку про стриминг.
local function homeOf(item)
	local place = item:GetAttribute(HOME_ATTRIBUTE)
	if typeof(place) == "CFrame" then
		return place
	end
	return nil
end

local home = {} -- [артефакт] = место, где он висит на самом деле
local busy = {} -- [артефакт] = сейчас летит к игроку
local gone = {} -- [артефакт] = уже собран, его не видно

local function effectsOf(item)
	local list = {}
	for _, child in ipairs(item:GetDescendants()) do
		if child:IsA("Light") or child:IsA("Sparkles") or child:IsA("ParticleEmitter") then
			table.insert(list, child)
		end
	end
	return list
end

-- Находка: артефакт подпрыгивает, а потом с разгоном летит к игроку,
-- уменьшаясь и растворяясь на лету.
local function fly(item)
	if not isArtifact(item) or busy[item] or gone[item] then
		return
	end
	busy[item] = true

	local base = home[item] or homeOf(item) or pivotOf(item)
	local pieces = partsOf(item)
	local sizes, clears = {}, {}
	for index, piece in ipairs(pieces) do
		sizes[index] = piece.Size
		clears[index] = piece.Transparency
	end
	local effects = effectsOf(item)
	local bright = {}
	for index, effect in ipairs(effects) do
		if effect:IsA("Light") then
			bright[index] = effect.Brightness
		end
	end

	-- Размер и прозрачность меняем деталь за деталью: Model:ScaleTo двигает
	-- ещё и пивот модели, а он у нас в это время сам летит к игроку.
	local function shape(factor, fade)
		for index, piece in ipairs(pieces) do
			piece.Size = sizes[index] * factor
			piece.Transparency = clears[index] + (1 - clears[index]) * fade
		end
	end

	local POP, FLY = 0.2, 0.55
	local passed = 0
	local link
	link = RunService.RenderStepped:Connect(function(step)
		passed = passed + step
		if passed <= POP then
			local a = passed / POP
			setPivot(item, base * CFrame.new(0, a * 1.6, 0) * CFrame.Angles(0, a * math.pi, 0))
			shape(1 + 0.35 * math.sin(a * math.pi), 0)
			return
		end

		local a = math.min((passed - POP) / FLY, 1)
		local speed = a * a -- к игроку артефакт летит с разгоном
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		local from = base.Position + Vector3.new(0, 1.6, 0)
		local to = head and (head.Position + Vector3.new(0, 0.6, 0)) or from
		setPivot(item, CFrame.new(from:Lerp(to, speed)) * CFrame.Angles(0, a * math.pi * 6, 0))
		shape(1 - 0.95 * speed, speed)
		for index, effect in ipairs(effects) do
			if bright[index] then
				effect.Brightness = bright[index] * (1 - a)
			end
		end

		if a >= 1 then
			link:Disconnect()
			busy[item] = nil
			gone[item] = true
			-- Артефакт возвращается на своё место — уже невидимым. Иначе он
			-- остаётся там, куда прилетел: в Team Create такой сдвиг оседает
			-- в плейсе, и на следующем занятии артефакт висит посреди лабиринта.
			setPivot(item, base)
			for index, piece in ipairs(pieces) do
				piece.Size = sizes[index]
				piece.Transparency = 1
				piece.CanCollide = false
				piece.CanTouch = false
			end
			for _, effect in ipairs(effects) do
				effect.Enabled = false
			end
		end
	end)
end

-- Пока артефакт не найден, он покачивается и медленно крутится: так его видно
-- издалека и понятно, что его можно взять.
RunService.RenderStepped:Connect(function()
	local clock = os.clock()
	for _, item in ipairs(CollectionService:GetTagged(TAG)) do
		if isArtifact(item) and not gone[item] and not busy[item] then
			local base = home[item] or homeOf(item)
			-- Дома ещё нет — значит, серверная часть до этого артефакта не
			-- дошла или он не догрузился. Трогать его нельзя: сдвинем не туда.
			if base then
				home[item] = base
				local phase = (base.Position.X + base.Position.Z) * 0.1
				setPivot(item, base
					* CFrame.new(0, math.sin(clock * 1.8 + phase) * 0.35, 0)
					* CFrame.Angles(0, clock * 1.1, 0))
			end
		end
	end
end)

collected.OnClientEvent:Connect(function(item, name, note, mine, all)
	setCount(mine, all)
	if not item then
		return -- пустая находка: это просто первое известие о числе артефактов
	end
	bumpCounter()
	fly(item)
	-- В заголовке не имя объекта: в Explorer артефакты называют как удобно
	-- строителю (Artifact_Fork), и такое имя в уведомлении выглядит отладкой.
	-- Имя приходит с сервера и остаётся доступным тем, кому оно нужно.
	local body = note
	if body == "" then
		body = string.format("Собрано %d из %d", mine, all)
	end
	notify("Артефакт найден", body, 5)
	if mine >= all and all > 0 then
		task.delay(1.2, function()
			notify("Все артефакты собраны", "Портал открыт — возвращайся к выходу", 5)
		end)
	end
end)
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<token name="RunContext">2</token>
				<string name="Name">ArtifactClient</string>
			</Properties>
		</Item>
	</Item>
</roblox>
