			<string name="Name">ArtifactCollector</string>
		</Properties>
		<Item class="RemoteEvent" referent="RBX6C0CCC65FED44F2899946A3C917A08D0">
			<Properties>
				<string name="Name">Collected</string>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX64089B405BD94FEBA6B24CA813E8E3EA">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Модуль курса «Артефакты» (ArtifactCollector) — серверная часть, урок 28.
--
-- Что делает: считает артефакты, собранные игроком, и сообщает его экрану
-- о каждой находке. Больше ничего: деталей не строит, мир не меняет.
--
-- Артефакт — это ЛЮБАЯ закреплённая деталь с тегом Artifact. Внутри артефакта
-- может лежать StringValue — записка, её текст игрок увидит в момент находки.
--
-- Счёт у каждого игрока свой: гость, зашедший в игру позже хозяина, собирает
-- артефакты сам, чужие находки его счётчик не трогают. Число собранного
-- записывается игроку в атрибут Artifacts — по нему выход находит тех, кому
-- уже можно открыть портал (модуль «Портал», урок 28).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local TAG = "Artifact"

local folder = script.Parent
local collected = folder:WaitForChild("Collected")

local taken = {} -- [Player] = { [деталь] = true }
local count = {} -- [Player] = сколько артефактов собрано

local function total()
	local n = 0
	for _, part in ipairs(CollectionService:GetTagged(TAG)) do
		if part:IsA("BasePart") and part:IsDescendantOf(workspace) then
			n = n + 1
		end
	end
	return n
end

local function noteOf(part)
	local value = part:FindFirstChildWhichIsA("StringValue")
	return value and value.Value or ""
end

local function collect(player, part)
	local mine = taken[player]
	if not mine or mine[part] then
		return
	end
	mine[part] = true
	count[player] = count[player] + 1
	-- Атрибут игрока: по нему артефакты видит любой другой скрипт в игре —
	-- портал-выход, финальная награда.
	player:SetAttribute("Artifacts", count[player])
	collected:FireClient(player, part, part.Name, noteOf(part), count[player], total())
end

local function playerOf(hit)
	local character = hit and hit.Parent
	local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return Players:GetPlayerFromCharacter(character)
end

local function watch(part)
	if not part:IsA("BasePart") then
		return
	end
	-- Артефакт — награда, а не стена: сквозь него проходят.
	part.CanCollide = false
	part.Touched:Connect(function(hit)
		local player = playerOf(hit)
		if player then
			collect(player, part)
		end
	end)
end

for _, part in ipairs(CollectionService:GetTagged(TAG)) do
	watch(part)
end
CollectionService:GetInstanceAddedSignal(TAG):Connect(watch)

local function ready(player)
	taken[player] = taken[player] or {}
	count[player] = count[player] or 0
	-- Пустая находка: экран просто узнаёт, сколько артефактов в лабиринте всего.
	collected:FireClient(player, nil, "", "", count[player], total())
end

Players.PlayerAdded:Connect(function(player)
	player:SetAttribute("Artifacts", 0)
	ready(player)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		ready(player)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	taken[player] = nil
	count[player] = nil
end)

for _, player in ipairs(Players:GetPlayers()) do
	ready(player)
end
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<token name="RunContext">1</token>
				<string name="Name">ArtifactServer</string>
			</Properties>
