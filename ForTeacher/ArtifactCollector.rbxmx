		<Item class="Script" referent="RBXCC397CDDCE9A4E8AB28EDBD620B8A3EE">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Модуль курса «Артефакты» (ArtifactCollector) — экранная часть, урок 28.
--
-- Что делает: рисует счётчик артефактов, показывает записку из найденного артефакта
-- и разыгрывает саму находку — артефакт подпрыгивает, закручивается, уменьшается
-- и улетает к игроку, растворяясь на лету.
--
-- Всё это происходит только на экране игрока: артефакт, который забрал один
-- игрок, остальные по-прежнему видят на месте.
--
-- Панели собраны в манере самого Roblox: тёмная плашка со скруглением, шрифт
-- Builder Sans, белый заголовок и серая строка под ним. Ни обводок, ни рамок:
-- в интерфейсе Roblox их нет, а на тёмном фоне лабиринта они выглядят наклейкой.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local TAG = "Artifact"

local folder = script.Parent
local collected = folder:WaitForChild("Collected")

local player = Players.LocalPlayer
while not player do
	task.wait()
	player = Players.LocalPlayer
end

-- ЭКРАН ---------------------------------------------------------------------

-- Builder Sans — системный шрифт интерфейсов Roblox. Если сборка Studio его
-- ещё не знает, откатываемся на Gotham: он стоял в интерфейсах до него.
local function fontOf(names)
	for _, name in ipairs(names) do
		local ok, value = pcall(function()
			return Enum.Font[name]
		end)
		if ok and value then
			return value
		end
	end
	return Enum.Font.SourceSans
end

local FONT_BOLD = fontOf({ "BuilderSansBold", "GothamBold" })
local FONT_TEXT = fontOf({ "BuilderSansMedium", "GothamMedium", "Gotham" })

local PANEL = Color3.fromRGB(25, 27, 31)
local TEXT = Color3.fromRGB(255, 255, 255)
local MUTED = Color3.fromRGB(178, 182, 190)
-- Текст записки светлее приглушённого: её читают, а не просматривают
local NOTE = Color3.fromRGB(232, 235, 240)
local ACCENT = Color3.fromRGB(120, 220, 255)

local gui = Instance.new("ScreenGui")
gui.Name = "TicketGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(object, radius)
	local item = Instance.new("UICorner")
	item.CornerRadius = UDim.new(0, radius)
	item.Parent = object
	return item
end

-- Счётчик: тёмная плашка вверху по центру, слово серым, число белым.
-- Раскладка задана вручную: UIListLayout выстроил бы в тот же ряд и полоску
-- прогресса — она ребёнок той же плашки.
local counter = Instance.new("Frame")
counter.Name = "Counter"
counter.AnchorPoint = Vector2.new(0.5, 0)
counter.Position = UDim2.new(0.5, 0, 0, 12)
counter.Size = UDim2.new(0, 176, 0, 44)
counter.BackgroundColor3 = PANEL
counter.BackgroundTransparency = 0.15
counter.BorderSizePixel = 0
counter.Parent = gui
corner(counter, 10)

local counterName = Instance.new("TextLabel")
counterName.Name = "Label"
counterName.BackgroundTransparency = 1
counterName.Position = UDim2.new(0, 14, 0, 0)
counterName.Size = UDim2.new(0, 60, 0, 34)
counterName.Font = FONT_TEXT
counterName.TextColor3 = MUTED
counterName.TextSize = 15
counterName.TextXAlignment = Enum.TextXAlignment.Left
counterName.Text = "Артефакты"
counterName.Parent = counter

local counterValue = Instance.new("TextLabel")
counterValue.Name = "Value"
counterValue.AnchorPoint = Vector2.new(1, 0)
counterValue.BackgroundTransparency = 1
counterValue.Position = UDim2.new(1, -14, 0, 0)
counterValue.Size = UDim2.new(0, 74, 0, 34)
counterValue.Font = FONT_BOLD
counterValue.TextColor3 = TEXT
counterValue.TextSize = 20
counterValue.TextXAlignment = Enum.TextXAlignment.Right
counterValue.Text = "0 / 0"
counterValue.Parent = counter

-- Полоска прогресса по нижнему краю плашки — как в панелях Roblox
local track = Instance.new("Frame")
track.Name = "Track"
track.AnchorPoint = Vector2.new(0.5, 1)
track.Position = UDim2.new(0.5, 0, 1, -8)
track.Size = UDim2.new(1, -28, 0, 3)
track.BackgroundColor3 = Color3.fromRGB(60, 64, 72)
track.BackgroundTransparency = 0.2
track.BorderSizePixel = 0
track.Parent = counter
corner(track, 2)

local fill = Instance.new("Frame")
fill.Name = "Fill"
fill.Size = UDim2.new(0, 0, 1, 0)
fill.BackgroundColor3 = ACCENT
fill.BorderSizePixel = 0
fill.Parent = track
corner(fill, 2)

-- Уведомление о находке: тёмная карточка снизу по центру
local toast = Instance.new("Frame")
toast.Name = "Note"
toast.AnchorPoint = Vector2.new(0.5, 1)
toast.Position = UDim2.new(0.5, 0, 1, -48)
toast.Size = UDim2.new(0, 420, 0, 96)
toast.BackgroundColor3 = PANEL
toast.BackgroundTransparency = 1
toast.BorderSizePixel = 0
toast.Visible = false
toast.Parent = gui
corner(toast, 10)

-- Полоска слева вместо значка: у Roblox уведомление тоже начинается с метки
local mark = Instance.new("Frame")
mark.Name = "Mark"
mark.AnchorPoint = Vector2.new(0, 0.5)
mark.Position = UDim2.new(0, 14, 0.5, 0)
mark.Size = UDim2.new(0, 3, 0, 60)
mark.BackgroundColor3 = ACCENT
mark.BackgroundTransparency = 1
mark.BorderSizePixel = 0
mark.Parent = toast
corner(mark, 2)

local toastTitle = Instance.new("TextLabel")
toastTitle.Name = "Title"
toastTitle.BackgroundTransparency = 1
toastTitle.Position = UDim2.new(0, 28, 0, 12)
toastTitle.Size = UDim2.new(1, -44, 0, 24)
toastTitle.Font = FONT_BOLD
toastTitle.TextColor3 = TEXT
toastTitle.TextSize = 19
toastTitle.TextXAlignment = Enum.TextXAlignment.Left
toastTitle.Text = ""
toastTitle.Parent = toast

local toastText = Instance.new("TextLabel")
toastText.Name = "Text"
toastText.BackgroundTransparency = 1
toastText.Position = UDim2.new(0, 28, 0, 38)
toastText.Size = UDim2.new(1, -44, 0, 48)
toastText.Font = FONT_TEXT
toastText.TextColor3 = NOTE
toastText.TextSize = 18
toastText.TextWrapped = true
toastText.TextXAlignment = Enum.TextXAlignment.Left
toastText.TextYAlignment = Enum.TextYAlignment.Top
toastText.Text = ""
toastText.Parent = toast

-- Финальное окно
local finale = Instance.new("Frame")
finale.Name = "Finale"
finale.AnchorPoint = Vector2.new(0.5, 0.5)
finale.Position = UDim2.new(0.5, 0, 0.4, 0)
finale.Size = UDim2.new(0, 380, 0, 104)
finale.BackgroundColor3 = PANEL
finale.BackgroundTransparency = 1
finale.BorderSizePixel = 0
finale.Visible = false
finale.Parent = gui
corner(finale, 12)

local finaleTitle = Instance.new("TextLabel")
finaleTitle.BackgroundTransparency = 1
finaleTitle.Position = UDim2.new(0, 0, 0, 26)
finaleTitle.Size = UDim2.new(1, 0, 0, 30)
finaleTitle.Font = FONT_BOLD
finaleTitle.TextColor3 = TEXT
finaleTitle.TextSize = 24
finaleTitle.TextTransparency = 1
finaleTitle.Text = "Все артефакты собраны"
finaleTitle.Parent = finale

local finaleText = Instance.new("TextLabel")
finaleText.BackgroundTransparency = 1
finaleText.Position = UDim2.new(0, 0, 0, 58)
finaleText.Size = UDim2.new(1, 0, 0, 22)
finaleText.Font = FONT_TEXT
finaleText.TextColor3 = MUTED
finaleText.TextSize = 15
finaleText.TextTransparency = 1
finaleText.Text = "Портал открыт"
finaleText.Parent = finale

local QUICK = TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local SLOW = TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local toastToken = 0

local function showNote(title, text)
	toastToken = toastToken + 1
	local token = toastToken
	toastTitle.Text = title
	toastText.Text = text
	toast.Visible = true
	toast.Position = UDim2.new(0.5, 0, 1, -34)
	toast.BackgroundTransparency = 1
	toastTitle.TextTransparency = 1
	toastText.TextTransparency = 1
	mark.BackgroundTransparency = 1

	TweenService:Create(toast, QUICK, {
		Position = UDim2.new(0.5, 0, 1, -48),
		BackgroundTransparency = 0.05,
	}):Play()
	TweenService:Create(toastTitle, QUICK, { TextTransparency = 0 }):Play()
	TweenService:Create(toastText, QUICK, { TextTransparency = 0 }):Play()
	TweenService:Create(mark, QUICK, { BackgroundTransparency = 0 }):Play()

	-- Шесть секунд: столько нужно, чтобы прочитать записку, и столько же
	-- держится уведомление в самом Roblox.
	task.delay(6, function()
		if token ~= toastToken then
			return
		end
		local fade = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		TweenService:Create(toast, fade, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(toastTitle, fade, { TextTransparency = 1 }):Play()
		TweenService:Create(toastText, fade, { TextTransparency = 1 }):Play()
		TweenService:Create(mark, fade, { BackgroundTransparency = 1 }):Play()
		task.wait(0.35)
		if token == toastToken then
			toast.Visible = false
		end
	end)
end

local function setCount(mine, all)
	counterValue.Text = string.format("%d / %d", mine, all)
	local share = all > 0 and math.clamp(mine / all, 0, 1) or 0
	TweenService:Create(fill, SLOW, { Size = UDim2.new(share, 0, 1, 0) }):Play()
end

local function bumpCounter()
	counterValue.TextSize = 24
	TweenService:Create(counterValue, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		TextSize = 20,
	}):Play()
end

local function showFinale()
	finale.Visible = true
	finale.Position = UDim2.new(0.5, 0, 0.4, 0.014)
	TweenService:Create(finale, SLOW, {
		BackgroundTransparency = 0.1,
		Position = UDim2.new(0.5, 0, 0.4, 0),
	}):Play()
	TweenService:Create(finaleTitle, SLOW, { TextTransparency = 0 }):Play()
	TweenService:Create(finaleText, SLOW, { TextTransparency = 0 }):Play()
	task.delay(5, function()
		local fade = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		TweenService:Create(finale, fade, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(finaleTitle, fade, { TextTransparency = 1 }):Play()
		TweenService:Create(finaleText, fade, { TextTransparency = 1 }):Play()
	end)
end

-- САМИ БИЛЕТЫ ---------------------------------------------------------------

local home = {} -- [деталь] = место, где артефакт висит на самом деле
local busy = {} -- [деталь] = артефакт сейчас летит к игроку
local gone = {} -- [деталь] = артефакт уже собран, его не видно

local function effectsOf(part)
	local list = {}
	for _, child in ipairs(part:GetDescendants()) do
		if child:IsA("Light") or child:IsA("Sparkles") or child:IsA("ParticleEmitter") then
			table.insert(list, child)
		end
	end
	return list
end

-- Находка: артефакт подпрыгивает, а потом с разгоном летит к игроку,
-- уменьшаясь и растворяясь на лету.
local function fly(part)
	if not part or not part:IsA("BasePart") or busy[part] or gone[part] then
		return
	end
	busy[part] = true

	local base = home[part] or part.CFrame
	local size = part.Size
	local clear = part.Transparency
	local effects = effectsOf(part)
	local bright = {}
	for index, effect in ipairs(effects) do
		if effect:IsA("Light") then
			bright[index] = effect.Brightness
		end
	end

	local POP, FLY = 0.2, 0.55
	local passed = 0
	local link
	link = RunService.RenderStepped:Connect(function(step)
		passed = passed + step
		if passed <= POP then
			local a = passed / POP
			part.CFrame = base * CFrame.new(0, a * 1.6, 0) * CFrame.Angles(0, a * math.pi, 0)
			part.Size = size * (1 + 0.4 * math.sin(a * math.pi))
			return
		end

		local a = math.min((passed - POP) / FLY, 1)
		local speed = a * a -- к игроку артефакт летит с разгоном
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		local from = base.Position + Vector3.new(0, 1.6, 0)
		local to = head and (head.Position + Vector3.new(0, 0.6, 0)) or from
		part.CFrame = CFrame.new(from:Lerp(to, speed)) * CFrame.Angles(0, a * math.pi * 6, 0)
		part.Size = size:Lerp(size * 0.05, speed)
		part.Transparency = clear + (1 - clear) * speed
		for index, effect in ipairs(effects) do
			if bright[index] then
				effect.Brightness = bright[index] * (1 - a)
			end
		end

		if a >= 1 then
			link:Disconnect()
			busy[part] = nil
			gone[part] = true
			-- Артефакт возвращается на своё место — уже невидимым. Иначе деталь
			-- остаётся там, куда прилетела: в Team Create такой сдвиг оседает
			-- в плейсе, и на следующем занятии артефакт висит посреди лабиринта.
			part.CFrame = base
			part.Transparency = 1
			part.CanCollide = false
			part.CanTouch = false
			for _, effect in ipairs(effects) do
				effect.Enabled = false
			end
		end
	end)
end

-- Пока артефакт не найден, он покачивается и медленно крутится: так его видно
-- издалека и понятно, что деталь можно взять.
RunService.RenderStepped:Connect(function()
	local clock = os.clock()
	for _, part in ipairs(CollectionService:GetTagged(TAG)) do
		if part:IsA("BasePart") and not gone[part] and not busy[part] then
			local base = home[part]
			if not base then
				base = part.CFrame
				home[part] = base
			end
			local phase = (base.Position.X + base.Position.Z) * 0.1
			part.CFrame = base
				* CFrame.new(0, math.sin(clock * 1.8 + phase) * 0.35, 0)
				* CFrame.Angles(0, clock * 1.1, 0)
		end
	end
end)

collected.OnClientEvent:Connect(function(part, name, note, mine, all)
	setCount(mine, all)
	if not part then
		return -- пустая находка: это просто первое известие о числе артефактов
	end
	bumpCounter()
	fly(part)
	showNote(name, note ~= "" and note or "Артефакт найден")
	if mine >= all and all > 0 then
		task.delay(0.9, showFinale)
	end
end)
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<token name="RunContext">2</token>
				<string name="Name">ArtifactClient</string>
			</Properties>
		</Item>
	</Item>
</roblox>
