		<Item class="LocalScript" referent="RBXF25B2EA52A8F4FB4B76F3B5E15C00190">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- MonsterAI.MonsterCamera — клиентская часть модуля: плавно разворачивает
-- камеру пойманного игрока на монстра.
--
-- ЛЕЖИТ В ПАПКЕ МОДУЛЯ ВЫКЛЮЧЕННЫМ (Disabled) и работает не отсюда:
-- серверная часть копирует этот скрипт каждому игроку в PlayerGui и там
-- включает. Так надо, потому что LocalScript внутри Workspace не
-- выполняется ВООБЩЕ — Roblox запускает их только в Player.Character,
-- PlayerGui, PlayerScripts, Backpack и ReplicatedFirst, причём молча, без
-- ошибки и предупреждения. На этом в своё время сгорело четыре захода
-- "камера не поворачивается": чинилось не то, код просто не исполнялся.
-- Той же причиной объясняется и то, что штатный Animate внутри модели
-- монстра никогда не проигрывал анимации.
--
-- Второй урок оттуда же: любой WaitForChild НА ВЕРХНЕМ УРОВНЕ клиентского
-- скрипта может увести в бесконечное ожидание всё, что написано ниже. При
-- включённом StreamingEnabled ждать чего-либо внутри Workspace с клиента —
-- риск: пока регион не подгрузился, WaitForChild просто висит. Поэтому
-- ожидание здесь — внутри task.spawn, а сам RemoteEvent живёт в
-- ReplicatedStorage: он реплицируется всегда и стримингом не выгружается.
--
-- Сервер не может подвинуть чужую камеру, это чисто клиентская вещь,
-- поэтому на момент поимки он присылает сюда сигнал с двумя аргументами:
-- сколько секунд держать разворот (та же длина, что идёт анимация удара) и
-- позицию головы монстра — так клиенту не нужна сама модель монстра.
--
-- Если в плейсе включён режим первого лица (StarterPlayer.CameraMode =
-- LockFirstPerson), он держится жёстче обычного и игнорирует прямую запись
-- в Camera, пока включён. Поэтому на время разворота режим временно
-- переключается на Classic, камера ставится Scriptable и твином доводится
-- до взгляда на монстра, а по окончании всё возвращается обратно. Разворот
-- именно твином, а не подстановкой CFrame: рывок в первом лице читается
-- как сбой картинки, а плавный доворот — как "тебя заставили посмотреть".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local EVENT_NAME = "MonsterCaught"
local TURN_TIME = 0.35

local player = Players.LocalPlayer

task.spawn(function()
	local caughtEvent = ReplicatedStorage:WaitForChild(EVENT_NAME)

	caughtEvent.OnClientEvent:Connect(function(duration, monsterPosition)
		local camera = workspace.CurrentCamera
		if not camera or not monsterPosition then
			return
		end

		local originalCameraMode = player.CameraMode
		player.CameraMode = Enum.CameraMode.Classic
		camera.CameraType = Enum.CameraType.Scriptable

		local eyePosition = camera.CFrame.Position
		local lookCFrame = CFrame.new(
			eyePosition,
			Vector3.new(monsterPosition.X, eyePosition.Y, monsterPosition.Z)
		)

		local holdTime = duration or 1
		local tween = TweenService:Create(
			camera,
			TweenInfo.new(math.min(TURN_TIME, holdTime), Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ CFrame = lookCFrame }
		)
		tween:Play()

		task.wait(holdTime)

		camera.CameraType = Enum.CameraType.Custom
		player.CameraMode = originalCameraMode
	end)
end)
]]></ProtectedString>
