<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="Folder" referent="RBX0D48260527D14D2D80059170106297C4">
		<Properties>
			<string name="Name">MonsterAI</string>
		</Properties>
		<Item class="Script" referent="RBX6F02CA738542473289112FBC845EC6C8">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- MonsterAI.MonsterServer — мозг обитателя лабиринта: патруль, погоня, удар.
--
-- КАК ПОЛЬЗОВАТЬСЯ: положить папку MonsterAI целиком внутрь модели монстра
-- (рядом с Humanoid и HumanoidRootPart) — и всё. Больше ничего расставлять
-- не нужно: модуль сам создаёт RemoteEvent в ReplicatedStorage и сам
-- раздаёт клиентскую часть игрокам. В плейсе не остаётся ни одной точки,
-- ни одного вспомогательного Part'а.
--
-- Что должно быть у модели монстра: Humanoid, HumanoidRootPart, Head.
-- Всё остальное — необязательно, модуль подстраивается (см. ниже).
--
-- НАСТРОЙКИ — атрибуты на САМОЙ ПАПКЕ MonsterAI (выделить папку в Explorer,
-- Properties → Attributes). Заводить их руками не нужно: они уже лежат в
-- модуле, ученик только меняет значения.
--   WalkAnimationId    0     анимация ходьбы (ID после Publish в ClipEditor)
--   AttackAnimationId  0     анимация удара
--   PatrolSpeed        6     скорость шага в патруле
--   ChaseSpeed         20    скорость в погоне
--   SightRange         24    на сколько студов видит игрока
--   CatchRange         5     с какой дистанции бьёт
--   CatchCooldown      5     сколько секунд не трогает того же игрока снова
--   AttackHoldTime     1     запасная длина удара, если у клипа её не узнать
--   ArrivePause        1.2   пауза в конце маршрута патруля
--   RetreatGrace       10    сколько секунд уходит прочь после поимки
--   ReplanDistance     8     насколько игрок должен уйти, чтобы пересчитать
--   MazeFolder         "Maze" имя папки лабиринта в Workspace (если она есть)
--
-- Оба ID анимаций модуль читает и с модели монстра тоже — договор урока 27
-- («ученик записывает ID в атрибуты модели») продолжает работать: значение
-- в папке главнее, ноль в папке означает «смотри на модели».
--
-- ДВИЖЕНИЕ. Путь считает PathfindingService, монстр идёт по его точкам —
-- это просто список позиций в памяти. Маршрут проходится ЦЕЛИКОМ, а не
-- кусками по 12 студов с пересчётом: пересчёт на ходу и был причиной того,
-- что монстр дёргался и топтался на месте. К очередной точке он не
-- «доезжает» до полной остановки — точка считается пройденной за ARRIVE_RADIUS
-- студов до неё, и цель сразу переносится на следующую. Отсюда непрерывный
-- ход вместо череды разгонов и торможений.
--
-- Если в Workspace есть папка лабиринта (MazeFolder), модуль дополнительно
-- строит по ней граф: каждая комната/коридор — узел, связь между парой
-- узлов, выровненных по одной оси и не дальше MAX_EDGE_DISTANCE,
-- подтверждается рейкастом (иначе соседи через стену считались бы
-- соединёнными просто по расстоянию). Граф нужен для двух вещей: цели
-- патруля (узел не ближе PATROL_MIN_STEPS переходов — монстр идёт через
-- половину лабиринта, а не топчется у соседней стены) и запасной маршрут
-- там, где ComputeAsync отдаёт NoPath — на стыках комната-коридор это
-- случается. Нет папки лабиринта — модуль работает и так: патруль бродит
-- по случайным точкам вокруг места, где монстра поставили.
--
-- ЗАТЫК. Если монстр за STUCK_WINDOW секунд сдвинулся меньше чем на
-- STUCK_DISTANCE — маршрут признаётся негодным и считается заново. Без этого
-- он упирался в угол и тёрся о стену до конца таймаута: именно это выглядело
-- как «регулярно ударяется о стенки».
--
-- ПРЕРЫВАНИЕ ДВИЖЕНИЯ МГНОВЕННОЕ: пока монстр идёт, условие остановки
-- проверяется каждый кадр (Heartbeat), а не раз в десятую секунды, и при
-- срабатывании снимается сама задача движения (humanoid:MoveTo в текущую
-- точку) — иначе Humanoid продолжал бы дошагивать до старой цели.
--
-- УДАР. На дистанции CatchRange монстр останавливается и играет свой трек.
-- Пойманного на это время замораживает (WalkSpeed/JumpPower в ноль,
-- AutoRotate выключен) и разворачивает лицом к себе: HumanoidRootPart крутит
-- сервер твином (это видят остальные игроки), а СОБСТВЕННЫЙ вид пойманного
-- разворачивает его же клиент — клиентская часть модуля (MonsterCamera).
-- После удара пойманного переносит на SpawnLocation (если он есть в плейсе),
-- потом монстр на RetreatGrace секунд уходит на самый дальний от входа узел
-- и никого не замечает — иначе он мог оказаться прямо у точки возрождения
-- в момент, когда игрок только-только возвращается.
--
-- ПРО АНИМАЦИИ, ЧТОБЫ НЕ ИСКАТЬ ЗАНОВО: анимации играет ЭТОТ серверный
-- скрипт напрямую (Humanoid:LoadAnimation + Play/Stop), а штатный Animate
-- внутри модели выключается. Он всё равно никогда не работал: LocalScript
-- внутри Workspace не выполняется вообще — Roblox запускает их только в
-- Player.Character, PlayerGui, PlayerScripts, Backpack и ReplicatedFirst,
-- причём молча, без ошибки. По той же причине клиентская часть модуля не
-- работает "на месте", а копируется каждому игроку в PlayerGui.
--
-- Вывод в Output — латиницей: кириллица в консоли Studio ломается.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")

local EVENT_NAME = "MonsterCaught"
local CLIENT_NAME = "MonsterCamera"

local package = script.Parent
local monster = package.Parent

local function report(text)
	print("[MonsterAI] " .. text)
end

local function problem(text)
	warn("[MonsterAI] " .. text)
end

-- Проверка "модуль положили куда надо" — понятная ошибка вместо молчания.
local humanoid = monster:FindFirstChildOfClass("Humanoid")
local root = monster:FindFirstChild("HumanoidRootPart")
local head = monster:FindFirstChild("Head")
if not (humanoid and root and head) then
	problem("papku MonsterAI nado polozhit VNUTR modeli monstra " ..
		"(ryadom s Humanoid, HumanoidRootPart i Head). Seichas ona lezhit v: " ..
		monster:GetFullName())
	return
end

-- СТРИМИНГ. При включённом Workspace.StreamingEnabled клиент игрока, стоящего
-- у точки возрождения, вообще не подгружает модель монстра в глубине
-- лабиринта, пока не подойдёт вплотную — монстр выглядит дёргающимся и
-- «неанимированным», хотя сервер ведёт его всё это время ровно. Модуль
-- лечит это сам, чтобы ученику не пришлось знать про стриминг: раньше
-- строчка стояла в сборочном скрипте плейса, и у любого, кто просто вставил
-- папку, баг возвращался.
pcall(function()
	monster.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
end)

-- ОБЩЕНИЕ С КЛИЕНТОМ ----------------------------------------------------------
-- RemoteEvent живёт в ReplicatedStorage, а не внутри монстра: там он
-- реплицируется всегда, а модель монстра при StreamingEnabled клиент может
-- и не иметь под рукой.
local caughtEvent = ReplicatedStorage:FindFirstChild(EVENT_NAME)
if not caughtEvent then
	caughtEvent = Instance.new("RemoteEvent")
	caughtEvent.Name = EVENT_NAME
	caughtEvent.Parent = ReplicatedStorage
end

-- Клиентская часть раздаётся копией каждому игроку в PlayerGui: там
-- LocalScript действительно запускается и переживает возрождение персонажа.
local clientTemplate = package:FindFirstChild(CLIENT_NAME)
if clientTemplate then
	local function installFor(player)
		local playerGui = player:FindFirstChildOfClass("PlayerGui")
			or player:WaitForChild("PlayerGui", 10)
		if not playerGui then
			return
		end
		local old = playerGui:FindFirstChild(CLIENT_NAME)
		if old then
			old:Destroy()
		end
		local copy = clientTemplate:Clone()
		copy.Disabled = false
		copy.Parent = playerGui
	end

	Players.PlayerAdded:Connect(function(player)
		task.spawn(installFor, player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(installFor, player)
	end
else
	problem("v papke modulya net " .. CLIENT_NAME .. " - kamera pri poimke ne razvernetsya")
end

-- НАСТРОЙКИ --------------------------------------------------------------------
-- Живут атрибутами на самой папке модуля: так их видно в Properties сразу
-- после того, как папку положили в модель, и ученику не приходится заводить
-- ни одного атрибута руками — только менять значения. Если папка пришла без
-- атрибутов (например, файлом .rbxmx), модуль заводит их сам значениями по
-- умолчанию при первом запуске.

local DEFAULTS = {
	WalkAnimationId = 0,
	AttackAnimationId = 0,
	PatrolSpeed = 6,
	ChaseSpeed = 20,
	SightRange = 24,
	CatchRange = 5,
	CatchCooldown = 5,
	AttackHoldTime = 1,
	ArrivePause = 1.2,
	RetreatGrace = 10,
	ReplanDistance = 8,
	MazeFolder = "Maze",
}

-- Порядок важен только для читаемости панели Properties: она показывает
-- атрибуты в том порядке, в котором они заведены.
local ORDER = {
	"WalkAnimationId", "AttackAnimationId",
	"PatrolSpeed", "ChaseSpeed", "SightRange", "CatchRange",
	"CatchCooldown", "AttackHoldTime", "ArrivePause", "RetreatGrace",
	"ReplanDistance", "MazeFolder",
}

for _, name in ipairs(ORDER) do
	if package:GetAttribute(name) == nil then
		package:SetAttribute(name, DEFAULTS[name])
	end
end

-- Значение берём с папки; на модели смотрим только ради старых сборок и
-- договора урока 27 (ID анимаций ученик записывал в атрибуты модели).
local function setting(name)
	local value = package:GetAttribute(name)
	if value == nil then
		value = monster:GetAttribute(name)
	end
	if value == nil then
		return DEFAULTS[name]
	end
	return value
end

local PATROL_SPEED = setting("PatrolSpeed")
local CHASE_SPEED = setting("ChaseSpeed")
local SIGHT_RANGE = setting("SightRange")
local CATCH_RANGE = setting("CatchRange")
local CATCH_COOLDOWN = setting("CatchCooldown")
local ATTACK_HOLD_DEFAULT = setting("AttackHoldTime")
local ARRIVE_PAUSE = setting("ArrivePause")
local RETREAT_GRACE = setting("RetreatGrace")
local REPLAN_DISTANCE = setting("ReplanDistance")

-- АНИМАЦИИ И ЗВУК ---------------------------------------------------------------

local animate = monster:FindFirstChild("Animate")
if animate then
	animate.Enabled = false
end

-- ID анимации: сначала папка модуля (там его и меняют), потом модель —
-- договор урока 27, где ученик записывал ID прямо в атрибуты монстра.
local function animationId(name)
	local value = package:GetAttribute(name)
	if typeof(value) == "number" and value > 0 then
		return value
	end
	value = monster:GetAttribute(name)
	if typeof(value) == "number" and value > 0 then
		return value
	end
	return 0
end

local walkTrack

local function applyWalkAnimation()
	if walkTrack then
		walkTrack:Stop()
		walkTrack:Destroy()
		walkTrack = nil
	end
	local id = animationId("WalkAnimationId")
	if id == 0 then
		problem("WalkAnimationId ne zapolnen (atribut papki MonsterAI) - " ..
			"hodit budet bez animacii")
		return
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. tostring(id)
	local ok, track = pcall(function()
		return humanoid:LoadAnimation(anim)
	end)
	if ok then
		track.Looped = true
		track.Priority = Enum.AnimationPriority.Movement
		walkTrack = track
	else
		problem("ne zagruzilas walk animatsiya " .. tostring(id) .. ": " .. tostring(track))
	end
end

applyWalkAnimation()
package:GetAttributeChangedSignal("WalkAnimationId"):Connect(applyWalkAnimation)
monster:GetAttributeChangedSignal("WalkAnimationId"):Connect(applyWalkAnimation)

local attackTrack

local function applyAttackAnimation()
	if attackTrack then
		attackTrack:Stop()
		attackTrack:Destroy()
		attackTrack = nil
	end
	local id = animationId("AttackAnimationId")
	if id == 0 then
		return
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. tostring(id)
	local ok, track = pcall(function()
		return humanoid:LoadAnimation(anim)
	end)
	if ok then
		track.Priority = Enum.AnimationPriority.Action
		attackTrack = track
	else
		problem("ne zagruzilas attack animatsiya " .. tostring(id) .. ": " .. tostring(track))
	end
end

applyAttackAnimation()
package:GetAttributeChangedSignal("AttackAnimationId"):Connect(applyAttackAnimation)
monster:GetAttributeChangedSignal("AttackAnimationId"):Connect(applyAttackAnimation)

-- Звук шагов — встроенный ассет Roblox (rbxasset, всегда доступен без
-- загрузки), слышный издалека: игрок слышит монстра раньше, чем видит.
-- Скорость воспроизведения растёт вместе со скоростью: на погоне шаги
-- звучат чаще, это тоже подсказка "он бежит, а не бродит".
local footstepSound = root:FindFirstChild("Footsteps")
if not footstepSound then
	footstepSound = Instance.new("Sound")
	footstepSound.Name = "Footsteps"
	footstepSound.SoundId = "rbxasset://sounds/action_footsteps_plastic.mp3"
	footstepSound.Looped = true
	footstepSound.Volume = 1
	footstepSound.RollOffMaxDistance = 150
	footstepSound.Parent = root
end

local function startWalking()
	if walkTrack and not walkTrack.IsPlaying then
		walkTrack:Play()
	end
	if not footstepSound.IsPlaying then
		footstepSound:Play()
	end
end

local function stopWalking()
	if walkTrack and walkTrack.IsPlaying then
		walkTrack:Stop()
	end
	if footstepSound.IsPlaying then
		footstepSound:Stop()
	end
end

-- Ходьба включается по факту движения, а не по тому, что "должен" делать
-- ИИ в эту секунду: иначе на паузах трек продолжал крутиться, пока риг
-- физически стоял на месте. Реальная скорость надёжнее предположений.
task.spawn(function()
	while monster.Parent do
		local speed = root.AssemblyLinearVelocity.Magnitude
		if speed > 1 then
			startWalking()
			footstepSound.PlaybackSpeed = math.clamp(speed / PATROL_SPEED, 0.8, 2.2)
		else
			stopWalking()
		end
		task.wait(0.15)
	end
end)

local function attackHoldTime()
	if attackTrack and attackTrack.Length and attackTrack.Length > 0.05 then
		return math.min(attackTrack.Length, 4)
	end
	return ATTACK_HOLD_DEFAULT
end

local function playAttack(holdTime)
	stopWalking()
	humanoid.WalkSpeed = 0
	humanoid:MoveTo(root.Position)

	if attackTrack then
		attackTrack:Play()
	else
		problem("AttackAnimationId ne zapolnen - udar bez animacii")
	end

	task.wait(holdTime)

	if attackTrack then
		attackTrack:Stop()
	end
end

-- ГРАФ ЛАБИРИНТА (необязательный) ----------------------------------------------

-- Соседство НЕ считается по фиксированному шагу сетки: обычные модули стоят
-- через 10 студов, но развилки и цель бывают крупнее (в лабиринте курса
-- Goal — комната 16x16, её центр отстоит от соседа на все 13 студов), и
-- поиск соседа строго "в 10 студах" такой узел вообще не находил.
local NODE_HEIGHT = 4
local MAX_EDGE_DISTANCE = 15

local mazeName = setting("MazeFolder")
if typeof(mazeName) ~= "string" or mazeName == "" then
	mazeName = "Maze"
end
local maze = workspace:FindFirstChild(mazeName)

local nodes = {}
local adjacency = {}

if maze then
	for _, child in ipairs(maze:GetChildren()) do
		if child:IsA("Model") then
			local ok, pivot = pcall(function()
				return child:GetPivot()
			end)
			if ok then
				table.insert(nodes, {
					position = Vector3.new(pivot.Position.X, NODE_HEIGHT, pivot.Position.Z),
					name = child.Name,
				})
			end
		end
	end

	local mazeRaycastParams = RaycastParams.new()
	mazeRaycastParams.FilterType = Enum.RaycastFilterType.Include
	mazeRaycastParams.FilterDescendantsInstances = { maze }

	local function isOpenBetween(posA, posB)
		local result = workspace:Raycast(posA, posB - posA, mazeRaycastParams)
		if not result then
			return true
		end
		return (result.Position - posB).Magnitude < 1
	end

	for i in ipairs(nodes) do
		adjacency[i] = {}
	end
	for i = 1, #nodes do
		for j = i + 1, #nodes do
			local a, b = nodes[i].position, nodes[j].position
			local sameX = math.abs(a.X - b.X) < 1
			local sameZ = math.abs(a.Z - b.Z) < 1
			if (sameX or sameZ) and not (sameX and sameZ) then
				if (a - b).Magnitude <= MAX_EDGE_DISTANCE and isOpenBetween(a, b) then
					adjacency[i][j] = true
					adjacency[j][i] = true
				end
			end
		end
	end

	report("graf labirinta iz " .. mazeName .. ": " .. #nodes .. " uzlov")
else
	report("papki " .. mazeName .. " net - patrul budet brodit vokrug tochki starta")
end

local hasGraph = #nodes >= 2

local function nearestNode(pos)
	local bestIndex, bestDist = 1, math.huge
	for i, node in ipairs(nodes) do
		local dist = (node.position - pos).Magnitude
		if dist < bestDist then
			bestIndex, bestDist = i, dist
		end
	end
	return bestIndex
end

-- Кратчайший путь по числу переходов (BFS, все рёбра равны по длине клетки).
local function bfsPath(fromIndex, toIndex)
	if fromIndex == toIndex then
		return { fromIndex }
	end
	local visited = { [fromIndex] = true }
	local cameFrom = {}
	local queue, queueHead = { fromIndex }, 1
	local found = false
	while queueHead <= #queue do
		local current = queue[queueHead]
		queueHead = queueHead + 1
		if current == toIndex then
			found = true
			break
		end
		for neighbor in pairs(adjacency[current]) do
			if not visited[neighbor] then
				visited[neighbor] = true
				cameFrom[neighbor] = current
				table.insert(queue, neighbor)
			end
		end
	end
	if not found then
		return nil
	end
	local path = { toIndex }
	local step = toIndex
	while step ~= fromIndex do
		step = cameFrom[step]
		table.insert(path, 1, step)
	end
	return path
end

-- Куда отступать после поимки: узел, самый дальний по числу переходов от
-- входа (за вход берём ближайший к точке возрождения узел графа).
local spawnPoint = workspace:FindFirstChildOfClass("SpawnLocation")
local retreatPosition = nil
if hasGraph and spawnPoint then
	local entranceIndex = nearestNode(spawnPoint.Position)
	local farthestIndex, farthestLen = entranceIndex, 0
	for i in ipairs(nodes) do
		local path = bfsPath(entranceIndex, i)
		if path and #path > farthestLen then
			farthestIndex, farthestLen = i, #path
		end
	end
	retreatPosition = nodes[farthestIndex].position
	report("otstuplenie posle poimki: uzel " .. nodes[farthestIndex].name ..
		" (" .. farthestLen .. " shagov ot vhoda)")
end

-- ПОИСК ИГРОКА -----------------------------------------------------------------

local raycastParams = RaycastParams.new()
raycastParams.FilterDescendantsInstances = { monster }
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

local function canSee(hrp)
	local origin = root.Position + Vector3.new(0, 1, 0)
	local result = workspace:Raycast(origin, hrp.Position - origin, raycastParams)
	if not result then
		return true
	end
	return result.Instance:IsDescendantOf(hrp.Parent)
end

local function findTarget()
	local best, bestDist = nil, SIGHT_RANGE
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if hum and hrp and hum.Health > 0 then
			local dist = (hrp.Position - root.Position).Magnitude
			if dist <= bestDist and canSee(hrp) then
				best, bestDist = hrp, dist
			end
		end
	end
	return best
end

local function inCatchRange(target)
	return (root.Position - target.Position).Magnitude <= CATCH_RANGE
end

-- РАСЧЁТ ПУТИ ------------------------------------------------------------------

-- AgentRadius. Персонаж Roblox шириной около двух студов, то есть от центра
-- до плеча — стад. При радиусе 1.2 маршрут проходил в двух десятых стада от
-- стены: монстр всю дорогу тёрся о неё плечом, и это читалось как «бьётся о
-- стенки». 1.8 отводит маршрут почти на стад от стены и при этом пролезает в
-- коридоры лабиринта: они шириной 6 студов, значит от осевой линии до стены
-- три стада, и полоса, по которой агент считает путь, остаётся шириной 2.4
-- стада. Больше брать нельзя — на поворотах путь просто перестанет считаться.
-- WaypointSpacing мельче — на поворотах точки идут чаще, и угол срезается не
-- так грубо.
local agentParams = {
	AgentRadius = 1.8,
	AgentHeight = 5,
	AgentCanJump = false,
	WaypointSpacing = 4,
}

-- Виртуальные точки пути от монстра до цели: просто список позиций,
-- живущий ровно один отрезок пути. Никаких Part'ов в плейсе.
local function pathfindPoints(destinationPosition)
	local path = PathfindingService:CreatePath(agentParams)
	local ok = pcall(function()
		path:ComputeAsync(root.Position, destinationPosition)
	end)
	if not ok or path.Status ~= Enum.PathStatus.Success then
		return nil
	end
	local points = {}
	for _, waypoint in ipairs(path:GetWaypoints()) do
		table.insert(points, waypoint.Position)
	end
	return points
end

-- Запасной маршрут по графу: центры комнат по дороге плюс сама цель.
-- Нужен там, где ComputeAsync отдаёт NoPath (стыки комната-коридор).
local function graphPoints(destinationPosition)
	if not hasGraph then
		return nil
	end
	local path = bfsPath(nearestNode(root.Position), nearestNode(destinationPosition))
	if not path then
		return nil
	end
	local points = {}
	for i = 2, #path do
		table.insert(points, nodes[path[i]].position)
	end
	table.insert(points, destinationPosition)
	return points
end

local function routeTo(destinationPosition)
	return pathfindPoints(destinationPosition) or graphPoints(destinationPosition)
end

-- ДВИЖЕНИЕ ----------------------------------------------------------------------

-- За сколько студов до точки она считается пройденной. Humanoid тормозит
-- перед целью MoveTo, поэтому останавливаться на каждой точке маршрута
-- нельзя — цель переносится на следующую заранее, и ход выходит непрерывным.
local ARRIVE_RADIUS = 3.5
-- Последнюю точку проходим до конца: это и есть место, куда шли.
local FINAL_RADIUS = 2
-- Затык: сдвинулись меньше чем на STUCK_DISTANCE за STUCK_WINDOW секунд.
-- На PATROL_SPEED = 6 за 0.8 секунды нормальный ход даёт больше четырёх
-- студов, так что порог в полтора студа срабатывает только на настоящем
-- упоре в стену или в угол.
local STUCK_WINDOW = 0.8
local STUCK_DISTANCE = 1.5

-- Проходит маршрут целиком. Возвращает "arrived", "interrupted" (сработало
-- условие остановки) или "stuck" (упёрлись — маршрут надо считать заново).
local function followPath(points, stopNow, speed)
	humanoid.WalkSpeed = speed

	local index = 1
	local checkPosition = root.Position
	local checkClock = os.clock()

	while index <= #points do
		if stopNow() then
			humanoid:MoveTo(root.Position)
			return "interrupted"
		end

		local point = points[index]
		local flat = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z)
		local radius = (index == #points) and FINAL_RADIUS or ARRIVE_RADIUS
		if flat.Magnitude <= radius then
			index = index + 1
			checkPosition, checkClock = root.Position, os.clock()
		else
			humanoid:MoveTo(point)
			RunService.Heartbeat:Wait()

			if os.clock() - checkClock >= STUCK_WINDOW then
				if (root.Position - checkPosition).Magnitude < STUCK_DISTANCE then
					humanoid:MoveTo(root.Position)
					return "stuck"
				end
				checkPosition, checkClock = root.Position, os.clock()
			end
		end
	end

	return "arrived"
end

-- ПОИМКА -------------------------------------------------------------------------

local cooldownUntil = {}
local patrolDestination = nil
-- До этого момента (tick()) главный цикл игнорирует всех игроков — так
-- монстр гарантированно уходит в отступление после поимки, а не бросается
-- в погоню за тем же игроком на полпути.
local retreatUntil = 0

local FACE_TURN_TIME = 0.25

-- Поворачивает пойманного лицом к монстру через Tween его HumanoidRootPart.
-- SetNetworkOwner(nil) забирает у клиента физику на время поворота — иначе
-- клиент мог реплицировать свой CFrame поверх ещё не долетевшего твина.
local function turnCaughtToFace(character, hrp)
	local caughtHumanoid = character:FindFirstChildOfClass("Humanoid")
	local savedAutoRotate = caughtHumanoid and caughtHumanoid.AutoRotate
	if caughtHumanoid then
		caughtHumanoid.AutoRotate = false
	end

	local ownershipOk = pcall(function()
		hrp:SetNetworkOwner(nil)
	end)

	local lookAt = Vector3.new(head.Position.X, hrp.Position.Y, head.Position.Z)
	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(FACE_TURN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = CFrame.new(hrp.Position, lookAt) }
	)
	tween:Play()
	tween.Completed:Wait()

	return caughtHumanoid, savedAutoRotate, ownershipOk
end

local function tryCatch(hrp)
	local character = hrp.Parent
	local player = Players:GetPlayerFromCharacter(character)
	if player and cooldownUntil[player] and tick() < cooldownUntil[player] then
		return
	end

	root.CFrame = CFrame.lookAt(root.Position, Vector3.new(hrp.Position.X, root.Position.Y, hrp.Position.Z))

	-- Замораживаем пойманного на время удара: без этого он успевал уйти
	-- в сторону или спрыгнуть, пока играется анимация атаки монстра.
	local caughtHumanoid = character:FindFirstChildOfClass("Humanoid")
	local savedWalkSpeed, savedJumpPower
	if caughtHumanoid then
		savedWalkSpeed = caughtHumanoid.WalkSpeed
		savedJumpPower = caughtHumanoid.JumpPower
		caughtHumanoid.WalkSpeed = 0
		caughtHumanoid.JumpPower = 0
	end

	local _, savedAutoRotate, ownershipTaken = turnCaughtToFace(character, hrp)

	local holdTime = attackHoldTime()
	if player then
		-- Шлём и длину удара, и позицию головы: так клиенту не нужна сама
		-- модель монстра, которой у него при стриминге может не оказаться.
		caughtEvent:FireClient(player, holdTime, head.Position)
	end

	playAttack(holdTime)

	if spawnPoint and character.Parent then
		character:PivotTo(spawnPoint.CFrame + Vector3.new(0, 5, 0))
	end

	if caughtHumanoid then
		caughtHumanoid.WalkSpeed = savedWalkSpeed
		caughtHumanoid.JumpPower = savedJumpPower
		caughtHumanoid.AutoRotate = savedAutoRotate
	end
	if ownershipTaken then
		pcall(function()
			hrp:SetNetworkOwnershipAuto()
		end)
	end
	if player then
		cooldownUntil[player] = tick() + CATCH_COOLDOWN
	end

	if retreatPosition then
		patrolDestination = retreatPosition
		retreatUntil = tick() + RETREAT_GRACE
	end
end

-- ПАТРУЛЬ И ПОГОНЯ ---------------------------------------------------------------

local homePosition = root.Position

-- Цель патруля выбирается не среди всех узлов подряд, а среди дальних:
-- маршрут длиной в три и больше перехода читается как обход лабиринта.
-- Случайный сосед в двух шагах давал ту самую картину «мечется по углу».
local PATROL_MIN_STEPS = 3

local lastPatrolIndex = nil

local function pickPatrolDestination()
	if hasGraph then
		local fromIndex = nearestNode(root.Position)
		local far = {}
		for i in ipairs(nodes) do
			if i ~= fromIndex and i ~= lastPatrolIndex then
				local path = bfsPath(fromIndex, i)
				if path and #path >= PATROL_MIN_STEPS then
					table.insert(far, i)
				end
			end
		end
		if #far == 0 then
			-- Лабиринт крошечный или мы в тупике: годится любой другой узел.
			for i in ipairs(nodes) do
				if i ~= fromIndex then
					table.insert(far, i)
				end
			end
		end
		if #far > 0 then
			local chosen = far[math.random(1, #far)]
			lastPatrolIndex = chosen
			return nodes[chosen].position
		end
	end
	local angle = math.random() * math.pi * 2
	local radius = math.random(20, 60)
	return homePosition + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
end

-- Один маршрут патруля целиком: выбрали дальний узел — дошли — постояли.
-- Пересчёта на полпути больше нет, поэтому и рывков на ровном месте нет.
local function patrolStep()
	if not patrolDestination then
		patrolDestination = pickPatrolDestination()
	end

	local points = routeTo(patrolDestination)
	if not points then
		patrolDestination = nil
		task.wait(0.3)
		return
	end

	local result = followPath(points, function()
		return findTarget() ~= nil
	end, PATROL_SPEED)

	if result == "interrupted" then
		return
	end
	if result == "stuck" then
		-- Маршрут негодный (узел за стеной, дверь закрылась) — берём другой.
		patrolDestination = nil
		task.wait(0.2)
		return
	end

	patrolDestination = nil
	-- Пауза в конце маршрута, а не на каждой точке: монстр приходит в комнату,
	-- оглядывается и уходит дальше. Игроку это даёт окно на манёвр. Пауза
	-- прерывается появлением игрока — иначе монстр «не замечал» подошедшего
	-- целую секунду с лишним.
	stopWalking()
	humanoid.WalkSpeed = 0
	local waited = 0
	while waited < ARRIVE_PAUSE do
		if findTarget() then
			return
		end
		waited = waited + task.wait(0.1)
	end
end

-- Погоня. Видим игрока — идём прямо на него: между нами нет стены, и путь
-- считать незачем (а пересчёт как раз и стопорил монстра каждые пару шагов).
-- Не видим — считаем маршрут до места, где видели, и идём по нему, пока
-- игрок не покажется снова или не уйдёт далеко от этого места.
local function chaseStep(target)
	startWalking()

	if canSee(target) then
		humanoid.WalkSpeed = CHASE_SPEED
		humanoid:MoveTo(target.Position)
		RunService.Heartbeat:Wait()
		return
	end

	local lastSeen = target.Position
	local points = routeTo(lastSeen)
	if not points then
		humanoid:MoveTo(lastSeen)
		task.wait(0.1)
		return
	end

	local result = followPath(points, function()
		local stillTarget = findTarget()
		if not stillTarget then
			return true
		end
		if inCatchRange(stillTarget) then
			return true
		end
		if canSee(stillTarget) then
			return true -- увидели снова: дальше идём прямо
		end
		return (stillTarget.Position - lastSeen).Magnitude > REPLAN_DISTANCE
	end, CHASE_SPEED)

	if result == "stuck" then
		task.wait(0.15)
	end
end

task.spawn(function()
	while monster.Parent do
		local target = tick() >= retreatUntil and findTarget() or nil

		if target then
			patrolDestination = nil
			chaseStep(target)

			local caught = findTarget()
			if caught and inCatchRange(caught) then
				tryCatch(caught)
			end
		else
			patrolStep()
		end

		task.wait(0.05)
	end
end)

report("zapushen")
]]></ProtectedString>
