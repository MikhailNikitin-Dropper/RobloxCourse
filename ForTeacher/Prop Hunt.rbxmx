				<Item class="ModuleScript" referent="RBX0FF90AD48D8340B7970860873991DF29">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local Registry = require(script.Parent.Registry)
local Config = require(script.Parent.Config)

local GuiController = {}

local Player = Players.LocalPlayer

local Frame
local SearchBox
local WinFrame
local InfoFrame
local InfoLabel

local Labels = {}

local HasWon = false
local ShownInfo = {}

local function CheckWin()
	if HasWon then
		return
	end

	local hasItems = false

	for _, item in pairs(Registry:GetItems()) do
		hasItems = true

		if not item.Collected then
			return
		end
	end

	if not hasItems then
		return
	end

	HasWon = true

	WinFrame.Visible = true

	task.delay(3, function()
		if WinFrame then
			WinFrame.Visible = false
		end
	end)
end

local function ShowItemInfo(item)
	if ShownInfo[item.Model] then
		return
	end

	local Value = item.Model:FindFirstChildWhichIsA("StringValue")
	if not Value then
		return
	end

	ShownInfo[item.Model] = true

	InfoLabel.Text = Value.Value
	InfoFrame.Visible = true

	task.delay(3, function()
		InfoFrame.Visible = false
	end)
end

local function UpdateLabel(item)
	local Label = Labels[item.Model]

	if not Label then
		return
	end

	if item.Collected then
		Label.Text = "✅ " .. item.Name
		Label.TextColor3 = Color3.fromRGB(0,255,0)

		ShowItemInfo(item)
	else
		Label.Text = string.format("%s (%.0fm)", item.Name, item.Distance)
		Label.TextColor3 = Color3.new(1,1,1)
	end
end

local function CreateLabel(item)
	local Button = Instance.new("TextButton")

	Button.Name = item.Name
	Button.Size = UDim2.new(1,0,0,26)
	Button.BackgroundTransparency = 1
	Button.Font = Enum.Font.Gotham
	Button.TextSize = 15
	Button.TextXAlignment = Enum.TextXAlignment.Left
	Button.AutoButtonColor = false
	Button.Parent = Frame

	Labels[item.Model] = Button

	UpdateLabel(item)
end

local function RemoveLabel(item)
	local Label = Labels[item.Model]

	if Label then
		Label:Destroy()
		Labels[item.Model] = nil
	end
end

function GuiController:Start(gui)

	Frame = gui.MainFrame.ScrollingFrame
	SearchBox = gui.MainFrame.SearchBox

	WinFrame = gui:WaitForChild("WinFrame")
	WinFrame.Visible = false

	InfoFrame = gui:WaitForChild("InfoFrame")
	InfoLabel = InfoFrame:WaitForChild("TextLabel")
	InfoFrame.Visible = false

	Registry.Added.Event:Connect(CreateLabel)
	Registry.Removed.Event:Connect(RemoveLabel)
	Registry.Collected.Event:Connect(UpdateLabel)

	for _, item in pairs(Registry:GetItems()) do
		CreateLabel(item)
	end

	task.spawn(function()

		while true do

			task.wait(Config.RefreshRate)

			local Character = Player.Character
			if not Character then
				continue
			end

			local Root = Character:FindFirstChild("HumanoidRootPart")
			if not Root then
				continue
			end

			local Search = string.lower(SearchBox.Text)

			local Items = {}

			for _, item in pairs(Registry:GetItems()) do

				if item.Model and item.Model.Parent then

					item.Distance = (Root.Position - item.Model:GetPivot().Position).Magnitude

					if item.Distance <= Config.MaxDistance then
						table.insert(Items, item)
					end

				end

			end

			table.sort(Items, function(a, b)

				if a.Collected ~= b.Collected then
					return not a.Collected
				end

				return a.Distance < b.Distance

			end)

			for index, item in ipairs(Items) do

				local Label = Labels[item.Model]

				if Label then

					UpdateLabel(item)

					Label.LayoutOrder = index

					if Search == "" or string.find(string.lower(item.Name), Search, 1, true) then
						Label.Visible = true
					else
						Label.Visible = false
					end

				end

			end

			CheckWin()

		end

	end)

end

return GuiController]]></ProtectedString>
