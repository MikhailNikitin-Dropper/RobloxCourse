		<Item class="Folder" referent="RBXAFAD316332E349AC9DEF2485FE15839A">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">ServerScriptService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			</Properties>
			<Item class="Script" referent="RBX2AD862D9DA314E3EBDC1C934019EE2A9">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SyncCollected = ReplicatedStorage:WaitForChild("PropHunter").Remotes.SyncCollected
local TAG = "Prop Hunt"
local COLLECT_DISTANCE = 6

-- Collected[player][model] = true
local Collected = {}

Players.PlayerRemoving:Connect(function(player)
	Collected[player] = nil
end)

while wait() do

	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		if not character then
			continue
		end

		local root = character:FindFirstChild("HumanoidRootPart")
		if not root then
			continue
		end

		Collected[player] = Collected[player] or {}
		for _, model in ipairs(CollectionService:GetTagged(TAG)) do

			if not model:IsA("Model") then
				continue
			end

			if Collected[player][model] then
				continue
			end

			if not model.Parent then
				continue
			end

			local distance = (root.Position - model:GetPivot().Position).Magnitude
			if distance <= COLLECT_DISTANCE then

				Collected[player][model] = true

				print(player.Name .. " collected " .. model.Name)

				SyncCollected:FireClient(player, model)

			end
		end
	end
end]]></ProtectedString>
					<bool name="Disabled">false</bool>
