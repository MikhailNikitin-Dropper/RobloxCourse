<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="Folder" referent="RBX8A8AECB70CCF43198287EF5DC133AAA0">
		<Properties>
			<string name="Name">ExitPortal</string>
		</Properties>
		<Item class="Script" referent="RBX90720CB2CF26488FB4AFE1BCAE9B15A0">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- ExitPortal.PortalServer — выход из лабиринта, который открывает награда.
--
-- КАК ПОЛЬЗОВАТЬСЯ: положить папку ExitPortal целиком внутрь модели портала —
-- и всё. Больше ничего расставлять не нужно: модуль сам создаёт RemoteEvent в
-- ReplicatedStorage и сам раздаёт клиентскую часть игрокам.
--
-- ПРАВИЛО ПОРТАЛА — ОДНО, И ОНО НЕ МЕНЯЕТСЯ:
--   собрал нужное число артефактов → портал светится → вошёл → ты снаружи.
--   не собрал → портал тёмный → вошёл → ничего не происходит, на экране
--   написано, сколько ещё нужно.
--
-- Полотно НИКОГДА не бывает стеной. Раньше закрытый портал был твёрдым, а
-- открытый — нет, и это путало: игрок то упирался в портал, то проваливался
-- сквозь, а в игре на двоих одна и та же деталь была твёрдой для одного и
-- проходимой для другого (счёт-то у каждого свой). Теперь сквозь полотно
-- проходят всегда, а разницу видно глазами: тёмное оно или светится.
--
-- НАСТРОЙКИ — атрибуты на САМОЙ ПАПКЕ ExitPortal (выделить папку в Explorer,
-- Properties → Attributes). Заводить их руками не нужно, они уже в модуле:
--   RequiredArtifacts  3            сколько артефактов открывают портал
--   TargetName         "VictoryPad" деталь, на которую портал выносит
--   CelebrateTime      5            сколько секунд идёт салют на площадке
--   CounterAttribute   "Artifacts"  имя атрибута игрока, где лежит счёт
--
-- Всё остальное модуль решает сам: полотно — деталь по имени Gate, а если
-- такой нет, самая крупная деталь модели; цвета закрытого и открытого
-- портала фиксированы (закрытый остаётся таким, каким его покрасил ученик,
-- открытый светится). Раньше и это были настройки — семь атрибутов на модели
-- вместо четырёх понятных.
--
-- ДОГОВОР С МОДУЛЕМ АРТЕФАКТОВ (ArtifactCollector, урок 28): тот на каждую
-- находку пишет игроку атрибут Artifacts — сколько собрано. Этот модуль только
-- читает его. Никакой другой связи между модулями нет: их можно ставить в
-- любом порядке, а счёт можно вести чем угодно другим — достаточно писать
-- то же число в атрибут игрока (имя меняется настройкой CounterAttribute).
-- Тот же приём связи через один атрибут игрока уже был на уроке 20: бластер
-- писал Hits, таблица счёта читала.
--
-- ПОЧЕМУ ПОДСВЕТКА ПОРТАЛА — НА КЛИЕНТЕ: счёт у каждого игрока свой, поэтому
-- и портал открыт у каждого свой. Цвет и свет полотна меняет клиентская
-- часть — у себя на экране, как модуль артефактов прячет собранный артефакт
-- только у нашедшего. Сервер держит правду (кому можно пройти) и выполняет
-- сам перенос.
--
-- Клиентская часть лежит в папке модуля ВЫКЛЮЧЕННОЙ и работает не оттуда:
-- LocalScript внутри Workspace Roblox не запускает вообще — только в
-- Player.Character, PlayerGui, PlayerScripts, Backpack и ReplicatedFirst,
-- причём молча. Поэтому сервер копирует её каждому игроку в PlayerGui.
--
-- Вывод в Output — латиницей: кириллица в консоли Studio ломается.

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENT_NAME = "PortalState"
local CLIENT_NAME = "PortalScreen"
local GATE_NAME = "Gate"

local package = script.Parent
local portal = package.Parent

local function report(text)
	print("[ExitPortal] " .. text)
end

local function problem(text)
	warn("[ExitPortal] " .. text)
end

-- НАСТРОЙКИ -------------------------------------------------------------------
-- Живут атрибутами на самой папке модуля: так их видно в Properties сразу
-- после того, как папку положили в модель, и ученику не приходится заводить
-- ни одного атрибута руками — только менять значения. Если папка пришла без
-- атрибутов (например, файлом .rbxmx), модуль заводит их сам.

local DEFAULTS = {
	RequiredArtifacts = 3,
	TargetName = "VictoryPad",
	CelebrateTime = 5,
	CounterAttribute = "Artifacts",
}

local ORDER = { "RequiredArtifacts", "TargetName", "CelebrateTime", "CounterAttribute" }

for _, name in ipairs(ORDER) do
	if package:GetAttribute(name) == nil then
		package:SetAttribute(name, DEFAULTS[name])
	end
end

-- Значение берём с папки; на модели смотрим только ради старых сборок, где
-- атрибуты стояли на самой модели портала.
local function setting(name)
	local value = package:GetAttribute(name)
	if value == nil then
		value = portal:GetAttribute(name)
	end
	if value == nil then
		return DEFAULTS[name]
	end
	return value
end

-- Проверка "модуль положили куда надо" — понятная ошибка вместо молчания.
if not portal:IsA("Model") then
	problem("papku ExitPortal nado polozhit VNUTR modeli portala (Model). " ..
		"Seichas ona lezhit v: " .. portal:GetFullName())
	return
end

local function findGate()
	local named = portal:FindFirstChild(GATE_NAME)
	if named and named:IsA("BasePart") then
		return named
	end
	-- Запасной путь: самая крупная деталь модели. Полотно портала почти
	-- всегда крупнее деталей рамки, так что промахнуться трудно, но об
	-- этом честно сообщается в Output.
	local best, bestVolume = nil, 0
	for _, part in ipairs(portal:GetDescendants()) do
		if part:IsA("BasePart") then
			local volume = part.Size.X * part.Size.Y * part.Size.Z
			if volume > bestVolume then
				best, bestVolume = part, volume
			end
		end
	end
	if best then
		problem("v modeli portala net detali s imenem '" .. GATE_NAME ..
			"' - beru samuyu bolshuyu: " .. best.Name)
	end
	return best
end

local gate = findGate()
if not gate then
	problem("v modeli portala net ni odnoi detali - stavit modul nekuda")
	return
end

gate.Anchored = true
-- Сквозь полотно проходят всегда — и когда портал открыт, и когда закрыт.
-- Одно правило вместо двух, и никакой разницы между игроками: твёрдость
-- детали общая на всех, а счёт артефактов у каждого свой.
gate.CanCollide = false
gate.CanTouch = true

-- ОБЩЕНИЕ С КЛИЕНТОМ ----------------------------------------------------------
-- RemoteEvent живёт в ReplicatedStorage, а не внутри портала: там он
-- реплицируется всегда, а модель портала при StreamingEnabled клиент может
-- и не иметь под рукой.
local stateEvent = ReplicatedStorage:FindFirstChild(EVENT_NAME)
if not stateEvent then
	stateEvent = Instance.new("RemoteEvent")
	stateEvent.Name = EVENT_NAME
	stateEvent.Parent = ReplicatedStorage
end

local clientTemplate = package:FindFirstChild(CLIENT_NAME)
if clientTemplate then
	local function installFor(player)
		local playerGui = player:FindFirstChildOfClass("PlayerGui")
			or player:WaitForChild("PlayerGui", 10)
		if not playerGui then
			return
		end
		local old = playerGui:FindFirstChild(CLIENT_NAME)
		if old then
			old:Destroy()
		end
		local copy = clientTemplate:Clone()
		copy.Disabled = false
		copy.Parent = playerGui
	end

	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(installFor, player)
	end
	Players.PlayerAdded:Connect(function(player)
		task.spawn(installFor, player)
	end)
else
	problem("v papke ExitPortal net skripta " .. CLIENT_NAME ..
		" - portal budet rabotat, no bez podsvetki i podskazok")
end

-- СОСТОЯНИЕ ПОРТАЛА -----------------------------------------------------------

local function counterOf(player)
	local value = player:GetAttribute(setting("CounterAttribute"))
	if typeof(value) == "number" then
		return value
	end
	return 0
end

local function isOpenFor(player)
	return counterOf(player) >= setting("RequiredArtifacts")
end

local function tellClient(player)
	local required = setting("RequiredArtifacts")
	local have = counterOf(player)
	stateEvent:FireClient(player, {
		gate = gate,
		open = have >= required,
		have = have,
		required = required,
	})
end

local function watch(player)
	tellClient(player)
	player:GetAttributeChangedSignal(setting("CounterAttribute")):Connect(function()
		tellClient(player)
	end)
	-- Свойства полотна клиент меняет у себя, и при возрождении персонажа
	-- копия скрипта в PlayerGui переживает смерть, а вот выгруженная
	-- стримингом деталь могла вернуться в исходном виде — поэтому состояние
	-- пересылается ещё и на каждое появление персонажа.
	player.CharacterAdded:Connect(function()
		task.wait(1)
		tellClient(player)
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(watch, player)
end
Players.PlayerAdded:Connect(function(player)
	task.spawn(watch, player)
end)

-- ВЫХОД ИЗ ЛАБИРИНТА ----------------------------------------------------------

local function findTarget()
	local name = setting("TargetName")
	local direct = workspace:FindFirstChild(name)
	if direct then
		return direct
	end
	return workspace:FindFirstChild(name, true)
end

local function celebrate(target)
	local seconds = setting("CelebrateTime")
	local switched = {}
	for _, item in ipairs(target:GetDescendants()) do
		if item:IsA("ParticleEmitter") or item:IsA("Fire") or item:IsA("Sparkles") then
			if not item.Enabled then
				item.Enabled = true
				table.insert(switched, item)
			end
		end
	end
	if #switched == 0 then
		return
	end
	task.delay(seconds, function()
		for _, item in ipairs(switched) do
			if item.Parent then
				item.Enabled = false
			end
		end
	end)
end

local function positionOf(target)
	if target:IsA("BasePart") then
		return target.CFrame
	end
	if target:IsA("Model") then
		local ok, cframe = pcall(function()
			return target:GetPivot()
		end)
		if ok then
			return cframe
		end
	end
	return nil
end

local function sendHome(player, character)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end

	local target = findTarget()
	local landing = target and positionOf(target)
	if not landing then
		-- Деградация вместо зависания: нет площадки победы — возвращаем на
		-- точку возрождения, нет и её — оставляем игрока на месте.
		local spawnPoint = workspace:FindFirstChildOfClass("SpawnLocation")
		if spawnPoint then
			problem("net detali '" .. tostring(setting("TargetName")) ..
				"' - perenoshu na SpawnLocation")
			landing = spawnPoint.CFrame
		else
			problem("net ni '" .. tostring(setting("TargetName")) ..
				"', ni SpawnLocation - perenosit nekuda")
			return false
		end
	end

	root.CFrame = landing + Vector3.new(0, 5, 0)
	if target then
		celebrate(target)
	end
	return true
end

-- КАСАНИЕ ПОЛОТНА -------------------------------------------------------------

local busy = {} -- [Player] = true, пока идёт перенос

local function playerOf(hit)
	local character = hit and hit.Parent
	local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return Players:GetPlayerFromCharacter(character), character
end

gate.Touched:Connect(function(hit)
	local player, character = playerOf(hit)
	if not player or busy[player] then
		return
	end

	if not isOpenFor(player) then
		-- Закрытый портал молчит в Output, но не молчит на экране: подсказку
		-- «нужно ещё N» рисует клиентская часть, ей достаточно состояния.
		return
	end

	busy[player] = true
	-- Экран гасим ДО переноса и зажигаем после: без этого игрока просто
	-- дёргает через пол-лабиринта, и он не понимает, что произошло.
	stateEvent:FireClient(player, { leaving = true })
	task.wait(0.35)

	local moved = sendHome(player, character)
	if moved then
		stateEvent:FireClient(player, { won = true })
		report(player.Name .. " proshel portal")
	else
		stateEvent:FireClient(player, { won = false })
	end
	task.delay(3, function()
		busy[player] = nil
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	busy[player] = nil
end)

-- ДИАГНОСТИКА -----------------------------------------------------------------
-- Самая частая ошибка сборки: портал требует три артефакта, а в лабиринте их
-- другое число (или модуль артефактов вообще не поставлен). Тогда портал
-- либо не открыть никогда, либо он открывается раньше времени. Проверяем
-- один раз через несколько секунд после старта — к этому моменту все модули
-- уже на месте.

task.delay(5, function()
	local required = setting("RequiredArtifacts")
	local artifacts = 0
	for _, item in ipairs(CollectionService:GetTagged("Artifact")) do
		if (item:IsA("BasePart") or item:IsA("Model")) and item:IsDescendantOf(workspace) then
			artifacts = artifacts + 1
		end
	end
	if artifacts == 0 then
		problem("v pleise net ni odnogo obekta s tegom Artifact - portal ne otkroetsya")
	elseif artifacts < required then
		problem("artefaktov v pleise " .. artifacts .. ", a portal trebuet " ..
			required .. " - sobrat stolko nevozmozhno")
	else
		report("gotov: artefaktov " .. artifacts .. ", dlya vyhoda nuzhno " .. required)
	end
	if not findTarget() then
		problem("net detali '" .. tostring(setting("TargetName")) ..
			"' - vynosit budet na tochku vozrozhdeniya")
	end
end)
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<token name="RunContext">1</token>
				<string name="Name">PortalServer</string>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBXE21C5D5D0DFE43C38E893E5B965B97DD">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- ExitPortal.PortalScreen — экранная часть модуля портала: подсветка полотна,
-- подсказка вблизи и затемнение на время выхода.
--
-- ЛЕЖИТ В ПАПКЕ МОДУЛЯ ВЫКЛЮЧЕННОЙ (Disabled) и работает не оттуда: серверная
-- часть копирует этот скрипт каждому игроку в PlayerGui и там включает.
-- LocalScript внутри Workspace Roblox не запускает вообще — только в
-- Player.Character, PlayerGui, PlayerScripts, Backpack и ReplicatedFirst,
-- причём молча, без ошибки.
--
-- Почему вид портала — здесь, а не на сервере: счёт артефактов у каждого
-- игрока свой, значит и открыт портал у каждого свой. Цвет и свет полотна
-- меняются только на своём экране (как модуль артефактов прячет собранный
-- артефакт только у нашедшего), а сам выход разрешает сервер.
--
-- ЗАТЕМНЕНИЕ. Выход — это перенос через весь лабиринт, и без затемнения он
-- читается как сбой: игрока просто дёргает в другое место. Сервер шлёт
-- leaving, экран гаснет, происходит перенос, приходит won — экран
-- открывается уже снаружи, с надписью.
--
-- WaitForChild на верхнем уровне уводит в бесконечное ожидание всё, что ниже,
-- поэтому ожидание события — внутри task.spawn, а само событие живёт в
-- ReplicatedStorage: он реплицируется всегда и стримингом не выгружается.
--
-- Панели собраны в манере самого Roblox: чёрная плашка на половину
-- прозрачности, скругление 8, тонкая белая обводка, шрифт Builder Sans —
-- как в модуле артефактов, чтобы два модуля не выглядели из разных игр.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local EVENT_NAME = "PortalState"
local SHOW_DISTANCE = 16 -- с какого расстояния показывать подсказку
local WIN_TIME = 5 -- сколько секунд висит поздравление

local player = Players.LocalPlayer
while not player do
	task.wait()
	player = Players.LocalPlayer
end

-- ЭКРАН -----------------------------------------------------------------------

local function fontOf(names)
	for _, name in ipairs(names) do
		local ok, value = pcall(function()
			return Enum.Font[name]
		end)
		if ok and value then
			return value
		end
	end
	return Enum.Font.SourceSans
end

local FONT_BOLD = fontOf({ "BuilderSansBold", "GothamBold" })
local FONT_TEXT = fontOf({ "BuilderSansMedium", "GothamMedium", "Gotham" })

local PANEL = Color3.fromRGB(0, 0, 0)
local PANEL_TRANSPARENCY = 0.45
local TEXT = Color3.fromRGB(255, 255, 255)
local MUTED = Color3.fromRGB(200, 203, 209)
local OPEN_COLOR = Color3.fromRGB(120, 220, 255)

local gui = Instance.new("ScreenGui")
gui.Name = "PortalGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(object, radius)
	local item = Instance.new("UICorner")
	item.CornerRadius = UDim.new(0, radius)
	item.Parent = object
end

local function stroke(object)
	local line = Instance.new("UIStroke")
	line.Color = Color3.fromRGB(255, 255, 255)
	line.Transparency = 0.88
	line.Thickness = 1
	line.Parent = object
end

local function panel(name, size, position)
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = position
	frame.Size = size
	frame.BackgroundColor3 = PANEL
	frame.BackgroundTransparency = PANEL_TRANSPARENCY
	frame.BorderSizePixel = 0
	frame.Visible = false
	frame.Parent = gui
	corner(frame, 8)
	stroke(frame)
	return frame
end

local function line(parent, font, size, color, offsetY, height)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0, 0, 0, offsetY)
	label.Size = UDim2.new(1, 0, 0, height)
	label.Font = font
	label.TextColor3 = color
	label.TextSize = size
	label.Text = ""
	label.Parent = parent
	return label
end

-- Подсказка у портала
local hint = panel("Hint", UDim2.new(0, 320, 0, 74), UDim2.new(0.5, 0, 1, -110))
local hintTitle = line(hint, FONT_BOLD, 19, TEXT, 14, 24)
local hintNote = line(hint, FONT_TEXT, 15, MUTED, 40, 22)

-- Поздравление после выхода
local win = panel("Win", UDim2.new(0, 380, 0, 96), UDim2.new(0.5, 0, 0.4, 0))
local winTitle = line(win, FONT_BOLD, 26, TEXT, 22, 32)
local winNote = line(win, FONT_TEXT, 16, MUTED, 56, 22)
winTitle.Text = "Ты выбрался"
winNote.Text = "Лабиринт пройден — все артефакты у тебя"

-- Затемнение на время переноса
local fade = Instance.new("Frame")
fade.Name = "Fade"
fade.Size = UDim2.new(1, 0, 1, 0)
fade.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
fade.BackgroundTransparency = 1
fade.BorderSizePixel = 0
fade.Visible = false
fade.ZIndex = 10
fade.Parent = gui

-- ВИД ПОЛОТНА -----------------------------------------------------------------

local state = nil -- последнее полученное состояние
local original = nil -- как полотно выглядело до нас: {part, color, material}
local glow = nil -- наш локальный свет внутри полотна

local function remember(part)
	if original and original.part == part then
		return
	end
	original = { part = part, color = part.Color, material = part.Material }
end

-- Открытый портал светится, закрытый выглядит ровно так, как его покрасил
-- ученик. Цвета настройками больше не задаются: одна пара состояний вместо
-- двух атрибутов, которые всё равно ставили в те же два цвета.
local function paint(part, open)
	remember(part)
	if open then
		part.Color = OPEN_COLOR
		part.Material = Enum.Material.Neon
		if not glow or glow.Parent ~= part then
			if glow then
				glow:Destroy()
			end
			glow = Instance.new("PointLight")
			glow.Name = "PortalGlow"
			glow.Color = OPEN_COLOR
			glow.Brightness = 2
			glow.Range = 18
			glow.Parent = part
		else
			glow.Enabled = true
		end
	else
		part.Color = original.color
		part.Material = original.material
		if glow then
			glow.Enabled = false
		end
	end
end

-- ПОДСКАЗКА -------------------------------------------------------------------

local function updateHint()
	if not state or not state.gate or not state.gate.Parent then
		hint.Visible = false
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		hint.Visible = false
		return
	end

	local distance = (root.Position - state.gate.Position).Magnitude
	if distance > SHOW_DISTANCE then
		hint.Visible = false
		return
	end

	if state.open then
		hintTitle.Text = "Портал открыт"
		hintNote.Text = "Войди в свет — и ты снаружи"
	else
		local left = math.max(0, (state.required or 0) - (state.have or 0))
		hintTitle.Text = "Портал закрыт"
		hintNote.Text = "Нужно ещё артефактов: " .. left
	end
	hint.Visible = true
end

local lastCheck = 0
RunService.Heartbeat:Connect(function(delta)
	lastCheck = lastCheck + delta
	if lastCheck < 0.2 then
		return
	end
	lastCheck = 0
	local ok, err = pcall(updateHint)
	if not ok then
		warn("[ExitPortal] " .. tostring(err))
	end
end)

-- СОБЫТИЯ ОТ СЕРВЕРА ----------------------------------------------------------

local function showLeaving()
	hint.Visible = false
	fade.Visible = true
	fade.BackgroundTransparency = 1
	TweenService:Create(fade, TweenInfo.new(0.3), { BackgroundTransparency = 0 }):Play()
end

local function showWin(moved)
	-- Экран открывается уже снаружи: сначала гасим затемнение, потом надпись.
	local lift = TweenService:Create(fade, TweenInfo.new(0.5), { BackgroundTransparency = 1 })
	lift:Play()
	lift.Completed:Connect(function()
		fade.Visible = false
	end)

	if not moved then
		return
	end

	win.Visible = true
	win.BackgroundTransparency = 1
	TweenService:Create(win, TweenInfo.new(0.3), { BackgroundTransparency = PANEL_TRANSPARENCY }):Play()
	task.delay(WIN_TIME, function()
		win.Visible = false
	end)
end

task.spawn(function()
	local stateEvent = ReplicatedStorage:WaitForChild(EVENT_NAME)

	stateEvent.OnClientEvent:Connect(function(message)
		if type(message) ~= "table" then
			return
		end
		if message.leaving then
			showLeaving()
			return
		end
		if message.won ~= nil then
			showWin(message.won)
			return
		end

		state = message
		local gate = message.gate
		if gate and gate:IsA("BasePart") then
			local ok, err = pcall(function()
				paint(gate, message.open)
			end)
			if not ok then
				warn("[ExitPortal] " .. tostring(err))
			end
		end
	end)
end)
]]></ProtectedString>
				<bool name="Disabled">true</bool>
				<string name="Name">PortalScreen</string>
			</Properties>
		</Item>
	</Item>
</roblox>
