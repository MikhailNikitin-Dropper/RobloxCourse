		<Item class="Script" referent="RBXAA00D35A4D6248B4A4425FE38BB22950">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- TDClient — модуль курса «Защита королевства» (уроки 37–40), экран игрока.
--
-- Заставка и меню уровней, камера сверху, клики по клеткам и башням,
-- меню башен, панель башни, верхняя панель, экраны победы и поражения,
-- полёт снарядов. Настройки — в начале скрипта TDServer.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
if not player then
	return
end
local package = script.Parent
local action = package:WaitForChild("Action")
local shot = package:WaitForChild("Shot")
local notice = package:WaitForChild("Notice")
local camera = workspace.CurrentCamera

local LEVEL_TAG = "TDLevel"
local DARK = Color3.fromRGB(24, 26, 32)
local GOLD = Color3.fromRGB(255, 205, 80)
local GREEN = Color3.fromRGB(60, 170, 90)
local GREY = Color3.fromRGB(90, 92, 100)

------------------------------------------------------------------ помощники
local gui = Instance.new("ScreenGui")
gui.Name = "TDGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 10)
	c.Parent = obj
end

local function label(parent, text, size)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.GothamBold
	l.TextSize = size or 18
	l.Text = text
	l.Parent = parent
	return l
end

local function button(parent, text, color)
	local b = Instance.new("TextButton")
	b.BackgroundColor3 = color or GREEN
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 18
	b.Text = text
	b.AutoButtonColor = true
	b.Parent = parent
	corner(b, 8)
	return b
end

local function currentLevel()
	local name = player:GetAttribute("TDLevel")
	for _, f in ipairs(CollectionService:GetTagged(LEVEL_TAG)) do
		if f.Name == name and f:IsDescendantOf(workspace) then
			return f
		end
	end
end

local function levelNames()
	local raw = player:GetAttribute("TDLevels") or ""
	local names = {}
	for n in string.gmatch(raw, "[^\n]+") do
		table.insert(names, n)
	end
	return names
end

------------------------------------------------------------------ заставка
local title = Instance.new("Frame")
title.Size = UDim2.fromScale(1, 1)
title.BackgroundTransparency = 1
title.Parent = gui

local titleText = label(title, package:GetAttribute("Title") or "Tower Defense", 64)
titleText.AnchorPoint = Vector2.new(0.5, 0)
titleText.Position = UDim2.fromScale(0.5, 0.14)
titleText.Size = UDim2.new(0.9, 0, 0, 90)
titleText.TextStrokeTransparency = 0.2
titleText.TextScaled = true
package:GetAttributeChangedSignal("Title"):Connect(function()
	titleText.Text = package:GetAttribute("Title") or ""
end)

local playButton = button(title, "Играть", GREEN)
playButton.AnchorPoint = Vector2.new(0.5, 0)
playButton.Position = UDim2.fromScale(0.5, 0.62)
playButton.Size = UDim2.fromOffset(260, 64)
playButton.TextSize = 30

local levelMenu = Instance.new("Frame")
levelMenu.AnchorPoint = Vector2.new(0.5, 0)
levelMenu.Position = UDim2.fromScale(0.5, 0.42)
levelMenu.Size = UDim2.fromOffset(340, 300)
levelMenu.BackgroundTransparency = 1
levelMenu.Visible = false
levelMenu.Parent = title
local levelLayout = Instance.new("UIListLayout")
levelLayout.Padding = UDim.new(0, 10)
levelLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
levelLayout.Parent = levelMenu

local function showLevels()
	for _, c in ipairs(levelMenu:GetChildren()) do
		if c:IsA("GuiButton") then
			c:Destroy()
		end
	end
	local names = levelNames()
	local open = player:GetAttribute("TDOpen") or ""
	for i, name in ipairs(names) do
		local isOpen = string.sub(open, i, i) == "1"
		local b = button(levelMenu, isOpen and name or (name .. " — пройди предыдущий"), isOpen and GREEN or GREY)
		b.Size = UDim2.fromOffset(340, 52)
		b.LayoutOrder = i
		b.Active = isOpen
		b.MouseButton1Click:Connect(function()
			if isOpen then
				action:FireServer("Play", name)
			end
		end)
	end
end

playButton.MouseButton1Click:Connect(function()
	if #levelNames() > 1 then
		playButton.Visible = false
		levelMenu.Visible = true
		showLevels()
	else
		action:FireServer("Play", levelNames()[1])
	end
end)

------------------------------------------------------------------ верхняя панель
local hud = Instance.new("Frame")
hud.AnchorPoint = Vector2.new(0.5, 0)
hud.Position = UDim2.new(0.5, 0, 0, 12)
hud.Size = UDim2.fromOffset(460, 44)
hud.BackgroundColor3 = DARK
hud.BackgroundTransparency = 0.15
hud.Visible = false
hud.Parent = gui
corner(hud, 12)
local hudText = label(hud, "", 20)
hudText.Size = UDim2.fromScale(1, 1)

local flash = label(gui, "", 22)
flash.AnchorPoint = Vector2.new(0.5, 0)
flash.Position = UDim2.new(0.5, 0, 0, 62)
flash.Size = UDim2.fromOffset(500, 30)
flash.TextColor3 = GOLD
flash.TextStrokeTransparency = 0.3
flash.TextTransparency = 1

notice.OnClientEvent:Connect(function(text)
	flash.Text = text
	flash.TextTransparency = 0
	TweenService:Create(flash, TweenInfo.new(1.6), { TextTransparency = 1 }):Play()
end)

local function updateHud()
	local wave = player:GetAttribute("TDWave") or 0
	local waves = player:GetAttribute("TDWaves") or 0
	local count = player:GetAttribute("TDCountdown") or 0
	local money = player:GetAttribute("TDMoney") or 0
	local text = "Волна " .. wave .. " из " .. waves
	if count > 0 then
		text = text .. " · через " .. count .. " с"
	end
	hudText.Text = text .. " · Деньги: " .. money
end
for _, a in ipairs({ "TDWave", "TDWaves", "TDCountdown", "TDMoney" }) do
	player:GetAttributeChangedSignal(a):Connect(updateHud)
end

------------------------------------------------------------------ конец партии
local finale = Instance.new("Frame")
finale.AnchorPoint = Vector2.new(0.5, 0.5)
finale.Position = UDim2.fromScale(0.5, 0.45)
finale.Size = UDim2.fromOffset(420, 220)
finale.BackgroundColor3 = DARK
