------------------------------------------------------------------ меню башен
local catalog = ReplicatedStorage:WaitForChild("TDCatalog")

local popup = Instance.new("Frame")
popup.BackgroundColor3 = DARK
popup.BackgroundTransparency = 0.05
popup.Visible = false
popup.Parent = gui
corner(popup, 12)
local popupPad = Instance.new("UIPadding")
popupPad.PaddingTop = UDim.new(0, 8)
popupPad.PaddingBottom = UDim.new(0, 8)
popupPad.PaddingLeft = UDim.new(0, 8)
popupPad.PaddingRight = UDim.new(0, 8)
popupPad.Parent = popup
local popupLayout = Instance.new("UIListLayout")
popupLayout.FillDirection = Enum.FillDirection.Horizontal
popupLayout.Padding = UDim.new(0, 8)
popupLayout.SortOrder = Enum.SortOrder.LayoutOrder
popupLayout.Parent = popup
-- Строки панели идут в том порядке, в каком их добавили.
local popupOrder = 0
popup.ChildAdded:Connect(function(child)
	if child:IsA("GuiObject") then
		popupOrder += 1
		child.LayoutOrder = popupOrder
	end
end)

local selectedTile = nil
local selectedTower = nil
local rangeRing = nil

local function closeMenus()
	popup.Visible = false
	selectedTile = nil
	selectedTower = nil
	if rangeRing then
		rangeRing:Destroy()
		rangeRing = nil
	end
end

local function placeNear(frame, screenPos, size)
	local view = camera.ViewportSize
	local x = math.clamp(screenPos.X + 16, 8, view.X - size.X - 8)
	local y = math.clamp(screenPos.Y - size.Y / 2, 8, view.Y - size.Y - 8)
	frame.Position = UDim2.fromOffset(x, y)
	frame.Size = UDim2.fromOffset(size.X, size.Y)
end

local function preview(parent, model)
	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.new(1, 0, 0, 90)
	vp.BackgroundColor3 = Color3.fromRGB(40, 44, 54)
	vp.Ambient = Color3.fromRGB(170, 170, 170)
	vp.Parent = parent
	corner(vp, 8)
	local copy = model:Clone()
	copy.Parent = vp
	local cam = Instance.new("Camera")
	cam.Parent = vp
	vp.CurrentCamera = cam
	local box, size = copy:GetBoundingBox()
	local dist = math.max(size.X, size.Y, size.Z) * 1.6 + 2
	cam.CFrame = CFrame.lookAt(box.Position + Vector3.new(dist * 0.6, dist * 0.35, -dist * 0.8), box.Position)
	return vp
end

local function towerCards()
	local list = {}
	for _, m in ipairs(catalog:GetChildren()) do
		if m:IsA("Model") and not m:GetAttribute("IsUpgrade") then
			table.insert(list, m)
		end
	end
	table.sort(list, function(a, b)
		return (a:GetAttribute("Price") or 0) < (b:GetAttribute("Price") or 0)
	end)
	return list
end

local function clearPopup()
	popupOrder = 0
	for _, c in ipairs(popup:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

local function openTowerMenu(tile, screenPos)
	closeMenus()
	clearPopup()
	selectedTile = tile
	popupLayout.FillDirection = Enum.FillDirection.Horizontal
	local money = player:GetAttribute("TDMoney") or 0
	local list = towerCards()
	if #list == 0 then
		local l = label(popup, "Нет башен: положи модель в ServerStorage → Towers", 16)
		l.Size = UDim2.fromOffset(420, 40)
		l.TextWrapped = true
		placeNear(popup, screenPos, Vector2.new(436, 56))
		popup.Visible = true
		return
	end
	for _, model in ipairs(list) do
		local price = model:GetAttribute("Price") or 0
		local card = Instance.new("TextButton")
		card.Text = ""
		card.Size = UDim2.fromOffset(130, 160)
		card.BackgroundColor3 = money >= price and Color3.fromRGB(52, 58, 70) or Color3.fromRGB(45, 45, 48)
		card.AutoButtonColor = money >= price
		card.Parent = popup
		corner(card, 10)
		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 6)
		pad.PaddingLeft = UDim.new(0, 6)
		pad.PaddingRight = UDim.new(0, 6)
		pad.Parent = card
		local vp = preview(card, model)
		vp.Active = false
		local nameLabel = label(card, model.Name, 16)
		nameLabel.Position = UDim2.fromOffset(0, 96)
		nameLabel.Size = UDim2.new(1, 0, 0, 22)
		nameLabel.TextScaled = true
		local priceLabel = label(card, tostring(price), 18)
		priceLabel.Position = UDim2.fromOffset(0, 122)
		priceLabel.Size = UDim2.new(1, 0, 0, 24)
		priceLabel.TextColor3 = money >= price and GOLD or Color3.fromRGB(200, 90, 90)
		card.MouseButton1Click:Connect(function()
			if selectedTile and money >= price then
				action:FireServer("Place", selectedTile, model.Name)
				closeMenus()
			end
		end)
	end
	placeNear(popup, screenPos, Vector2.new(16 + #list * 138 - 8, 176))
	popup.Visible = true
end

local function showRange(tower)
	if rangeRing then
		rangeRing:Destroy()
	end
	local range = tower:GetAttribute("Range") or 15
	local box, size = tower:GetBoundingBox()
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.2, range * 2, range * 2)
	ring.CFrame = CFrame.new(box.Position.X, box.Position.Y - size.Y / 2 + 0.15, box.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(120, 200, 255)
	ring.Transparency = 0.75
	ring.Parent = camera
	rangeRing = ring
end

local function openTowerPanel(tower, screenPos)
	closeMenus()
	clearPopup()
	selectedTower = tower
	popupLayout.FillDirection = Enum.FillDirection.Vertical
	local function row(text, size)
		local l = label(popup, text, size or 16)
		l.Size = UDim2.new(1, 0, 0, 24)
		l.TextXAlignment = Enum.TextXAlignment.Left
		return l
	end
	row(tower.Name, 20).TextColor3 = GOLD
	row(("Урон %s · радиус %s · пауза %s с"):format(
		tower:GetAttribute("Damage") or "?", tower:GetAttribute("Range") or "?", tower:GetAttribute("Cooldown") or "?"))
	local nextName = tower:GetAttribute("Upgrade")
	local money = player:GetAttribute("TDMoney") or 0
	if nextName and nextName ~= "" then
		local price = tower:GetAttribute("UpgradePrice") or 0
		local up = button(popup, "Улучшить → " .. nextName .. " · " .. price, money >= price and GREEN or GREY)
		up.Size = UDim2.new(1, 0, 0, 40)
		up.MouseButton1Click:Connect(function()
			action:FireServer("Upgrade", tower)
			closeMenus()
		end)
	else
		row("Последний уровень")
	end
	local mode = button(popup, "Цель: " .. (tower:GetAttribute("TDMode") or "Первый"), Color3.fromRGB(70, 100, 160))
	mode.Size = UDim2.new(1, 0, 0, 40)
	mode.MouseButton1Click:Connect(function()
		action:FireServer("Mode", tower)
	end)
	tower:GetAttributeChangedSignal("TDMode"):Connect(function()
		mode.Text = "Цель: " .. (tower:GetAttribute("TDMode") or "Первый")
	end)
	local sell = button(popup, "Продать", Color3.fromRGB(170, 70, 60))
	sell.Size = UDim2.new(1, 0, 0, 40)
	sell.MouseButton1Click:Connect(function()
		action:FireServer("Sell", tower)
		closeMenus()
	end)
	placeNear(popup, screenPos, Vector2.new(300, 16 + 24 * 2 + 8 * 4 + 40 * 3 + 8))
	popup.Visible = true
	showRange(tower)
end

------------------------------------------------------------------ клики
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	if player:GetAttribute("TDPhase") ~= "playing" then
		return
	end
	local level = currentLevel()
	if not level then
		return
	end
	-- Позиция ввода — без верхней полосы Roblox: луч по ScreenPointToRay,
	-- а меню (экран с IgnoreGuiInset) сдвигаем на высоту полосы.
	local pos = input.Position
	local ray = camera:ScreenPointToRay(pos.X, pos.Y)
	local inset = GuiService:GetGuiInset()
	local at = Vector2.new(pos.X + inset.X, pos.Y + inset.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local active = workspace:FindFirstChild("TDActive")
	local skip = {}
	if active and active:FindFirstChild("Mobs") then
		table.insert(skip, active.Mobs)
	end
	params.FilterDescendantsInstances = skip
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	if not hit then
		closeMenus()
		return
	end
	local placement = level:FindFirstChild("Placement")
	local inst = hit.Instance
	local tower = inst
	while tower and not CollectionService:HasTag(tower, "TDTower") do
		tower = tower.Parent
	end
	if tower then
		openTowerPanel(tower, at)
	elseif placement and inst:IsDescendantOf(placement) then
		openTowerMenu(inst, at)
	else
		closeMenus()
	end
end)

player:GetAttributeChangedSignal("TDMoney"):Connect(function()
	-- Деньги изменились — меню башен перерисовать с новыми ценами.
	if popup.Visible and selectedTile then
		local p = popup.AbsolutePosition
		openTowerMenu(selectedTile, Vector2.new(p.X - 16, p.Y + popup.AbsoluteSize.Y / 2))
	end
end)

------------------------------------------------------------------ снаряды
shot.OnClientEvent:Connect(function(tower, target)
	if not (tower and target and tower.Parent and target.Parent) then
		return
	end
	local root = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
	local head = tower:FindFirstChild("Head") or tower.PrimaryPart
	if not (root and head) then
		return
	end
	local from, to = head.Position, root.Position
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = Vector3.new(0.6, 0.6, 0.6)
	p.CFrame = CFrame.lookAt(from, to)
	local decal = tower:FindFirstChild("Projectile", true)
	if decal and decal:IsA("Decal") then
		p.Transparency = 1
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromScale(3, 3)
		bb.Parent = p
		local img = Instance.new("ImageLabel")
		img.Size = UDim2.fromScale(1, 1)
		img.BackgroundTransparency = 1
		img.Image = decal.Texture
		img.Parent = bb
	else
		p.Shape = Enum.PartType.Ball
		p.Material = Enum.Material.Neon
		p.Color = GOLD
	end
	p.Parent = camera
	TweenService:Create(p, TweenInfo.new(0.25, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from).Unit) }):Play()
	Debris:AddItem(p, 0.3)
end)

------------------------------------------------------------------ камера и фазы
local orbit = 0
-- Камера ставится после стандартного модуля камеры, иначе он её перебьёт.
RunService:BindToRenderStep("TDCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	camera.CameraType = Enum.CameraType.Scriptable
	local phase = player:GetAttribute("TDPhase")
	if phase == "title" or phase == nil then
		local intro = workspace:FindFirstChild("Intro")
		local cam = intro and intro:FindFirstChild("Cam")
		if not cam then
			local first = levelNames()[1]
			for _, f in ipairs(CollectionService:GetTagged(LEVEL_TAG)) do
				if f.Name == first then
					cam = f:FindFirstChild("Cam")
				end
			end
		end
		if cam then
			orbit += dt * 0.15
			local cf = cam.CFrame
			camera.CFrame = CFrame.new(cf.Position) * CFrame.Angles(0, orbit, 0) * (cf - cf.Position)
		end
	else
		local level = currentLevel()
		local cam = level and level:FindFirstChild("Cam")
		if cam then
			camera.CFrame = cam.CFrame
		end
	end
end)

local function onPhase()
	local phase = player:GetAttribute("TDPhase")
	title.Visible = phase == "title" or phase == nil
	hud.Visible = phase == "playing" or phase == "won" or phase == "lost"
	finale.Visible = phase == "won" or phase == "lost"
	if phase == "title" or phase == nil then
		playButton.Visible = true
		levelMenu.Visible = false
	end
	if phase ~= "playing" then
		closeMenus()
	end
	if phase == "won" then
		finaleText.Text = "Победа!"
		finaleText.TextColor3 = GOLD
	elseif phase == "lost" then
		finaleText.Text = "Поражение"
		finaleText.TextColor3 = Color3.fromRGB(230, 90, 80)
	end
	menuButton.Visible = #levelNames() > 1
	againButton.Position = menuButton.Visible and UDim2.new(0.5, -190, 1, -84) or UDim2.new(0.5, -90, 1, -84)
	updateHud()
end
player:GetAttributeChangedSignal("TDPhase"):Connect(onPhase)
player:GetAttributeChangedSignal("TDLevels"):Connect(onPhase)
onPhase()
