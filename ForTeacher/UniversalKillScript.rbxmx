<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="Script" referent="RBX2BB9799941A54E64ABA9A8072BE291C2">
		<Properties>
			<ProtectedString name="Source"><![CDATA[-- Смертельная зона: любая деталь внутри модели, где лежит этот скрипт.
-- Защитное поле уважаем: пока у персонажа висит ForceField (первые секунды
-- после появления у точки возрождения), ловушка его не трогает — иначе игрок
-- гибнет в момент появления и выбраться не может.
local model = script.Parent

local function isProtected(character: Instance): boolean
	return character:FindFirstChildOfClass("ForceField") ~= nil
end

for _, part in pairs(model:GetDescendants()) do
	if part:IsA("BasePart") then
		part.Touched:Connect(function(otherPart: BasePart)
			local char = otherPart.Parent
			if not char then
				return
			end
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and not isProtected(char) then
				hum.Health = 0
			end
		end)
	end
end
]]></ProtectedString>
			<bool name="Disabled">false</bool>
			<Content name="LinkedSource"><null></null></Content>
			<token name="RunContext">0</token>
			<string name="ScriptGuid">{458494DC-4B07-416B-9FEC-295C537BAE5D}</string>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<string name="Name">KillScript</string>
			<int64 name="SourceAssetId">75269316315197</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
		</Properties>
	</Item>
	<SharedStrings>
		<SharedString md5="yuZpQdnvvUBOTYh1jqZ2cA=="></SharedString>
	</SharedStrings>
</roblox>