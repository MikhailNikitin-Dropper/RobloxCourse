		<Item class="Script" referent="RBX77D6BE9CE7744269BFFDEE7F93FD2161">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local CheckpointSystem = script.Parent
local CheckpointsFolder = CheckpointSystem:GetChildren()
local Checkpoints = {}
for _, Checkpoint in pairs(CheckpointsFolder) do
	if Checkpoint:IsA("SpawnLocation") then
		table.insert(Checkpoints, Checkpoint)
	end
end
table.sort(Checkpoints, function(a, b) 
	return tonumber(a.Name) < tonumber(b.Name) 
end)
for _, Checkpoint in pairs(Checkpoints) do
	if Checkpoint:IsA("SpawnLocation") then
		Checkpoint.TeamColor = Checkpoint.BrickColor
		Checkpoint.Neutral = false
		local team = Instance.new("Team")
		team.TeamColor = Checkpoint.BrickColor
		team.Name = Checkpoint.Name
		if Checkpoint.Name == "1" then
			team.AutoAssignable = true
			game.Players.PlayerAdded:Connect(function(player: Player) 
				player.RespawnLocation = Checkpoint
			end)
		else
			team.AutoAssignable = false
		end
		team.Parent = game:GetService("Teams")
		Checkpoint.Touched:Connect(function(otherPart: BasePart) 
			local character = otherPart.Parent
			local player = game:GetService("Players"):GetPlayerFromCharacter(character)
			if player then
				if tonumber(player.Team.Name) < tonumber(Checkpoint.Name) then
					player.RespawnLocation = Checkpoint
					player.Team = team
				end
			end
		end)
	end
end
]]></ProtectedString>
