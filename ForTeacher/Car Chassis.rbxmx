		<Item class="Script" referent="RBX78021CEE401C405FB341A894EC5EF838">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Управление машиной.
-- Все настройки лежат в атрибутах модели Car Chassis:
-- выдели модель в Explorer -> панель Properties -> раздел Attributes.

local RunService = game:GetService("RunService")

local car = script.Parent
local driveSeat = car:WaitForChild("DriverSeat")

local motors = car:WaitForChild("Motors")

-- машина полноприводная: мотор стоит у каждого из четырёх колёс
local wheelMotors = {
	motors:WaitForChild("Fl"):WaitForChild("Motor"),
	motors:WaitForChild("Fr"):WaitForChild("Motor"),
	motors:WaitForChild("Bl"):WaitForChild("Motor"),
	motors:WaitForChild("Br"):WaitForChild("Motor"),
}

-- поворачиваются только передние колёса
local steerServos = {
	motors.Fl:WaitForChild("Servo"),
	motors.Fr:WaitForChild("Servo"),
}

-- руль в салоне крутится вместе с колёсами
local steeringWheel = motors:WaitForChild("Steering"):WaitForChild("Servo")

local WHEEL_RADIUS = 1.25 -- радиус колеса: переводит скорость машины в обороты колёс
local STEER_FALLOFF = 0.5 -- на полной скорости руль выкручивается вдвое слабее: машина не кувыркается
local BRAKE_SPEED = 3     -- медленнее этой скорости задний ход включается сразу, без торможения

-- Настройки машины: имя атрибута = {значение по умолчанию, минимум, максимум}.
-- Границы нужны, чтобы случайное огромное число не отправило машину в космос.
local SETTINGS = {
	MaxSpeed = {60, 0, 300},            -- скорость вперёд, в студах в секунду - как на спидометре
	ReverseSpeed = {30, 0, 300},        -- скорость назад, в студах в секунду
	TurnAngle = {35, 0, 60},            -- угол поворота передних колёс, в градусах
	Acceleration = {10000, 100, 50000}, -- тяга: как резво машина разгоняется
	BrakeForce = {20000, 100, 100000},  -- сила торможения
}

-- если атрибут удалили или вписали не число, машина едет на значении по умолчанию
local function setting(name)
	local default, low, high = table.unpack(SETTINGS[name])
	local value = car:GetAttribute(name)

	if typeof(value) ~= "number" then
		return default
	end

	return math.clamp(value, low, high)
end

for name, values in pairs(SETTINGS) do
	if car:GetAttribute(name) == nil then
		car:SetAttribute(name, values[1])
	end
end

-- шкала встроенного спидометра должна совпадать с настоящей максималкой
local function updateSpeedometer()
	driveSeat.MaxSpeed = setting("MaxSpeed")
end

-- у серво свои ограничители угла: держим их в согласии с атрибутом,
-- иначе колёса упрутся в старый предел и TurnAngle перестанет работать
local function updateSteerLimits()
	local angle = setting("TurnAngle")

	for _, servo in ipairs(steerServos) do
		servo.UpperAngle = angle
		servo.LowerAngle = -angle
	end
end

local lastVelocity, lastTorque, lastAngle

local function drive()
	local throttle = driveSeat.ThrottleFloat
	local steer = driveSeat.SteerFloat

	-- скорость вдоль машины: плюс - едем вперёд, минус - назад
	local speed = driveSeat.AssemblyLinearVelocity:Dot(driveSeat.CFrame.LookVector)
	local maxSpeed = setting("MaxSpeed")
	local velocity, torque

	if throttle == 0 then
		velocity, torque = 0, setting("Acceleration")
	elseif throttle * speed < 0 and math.abs(speed) > BRAKE_SPEED then
		-- жмём против движения: это торможение, а не задний ход
		velocity, torque = 0, setting("BrakeForce")
	elseif throttle > 0 then
		-- скорость машины делим на радиус колеса: получаем, как быстро крутить колёса
		velocity, torque = maxSpeed / WHEEL_RADIUS * throttle, setting("Acceleration")
	else
		velocity, torque = setting("ReverseSpeed") / WHEEL_RADIUS * throttle, setting("Acceleration")
	end

	-- чем быстрее едем, тем мягче руль: на прямой резкий поворот переворачивает машину
	local topSpeed = math.max(maxSpeed, 1)
	local falloff = 1 - STEER_FALLOFF * math.clamp(math.abs(speed) / topSpeed, 0, 1)
	local angle = setting("TurnAngle") * falloff * steer

	if velocity ~= lastVelocity or torque ~= lastTorque then
		for _, motor in ipairs(wheelMotors) do
			motor.AngularVelocity = velocity
			motor.MotorMaxTorque = torque
		end

		lastVelocity, lastTorque = velocity, torque
	end

	if angle ~= lastAngle then
		for _, servo in ipairs(steerServos) do
			servo.TargetAngle = angle
		end

		steeringWheel.TargetAngle = angle
		lastAngle = angle
	end
end

updateSpeedometer()
updateSteerLimits()
-- меняешь атрибут прямо во время теста - машина сразу едет по-новому
car:GetAttributeChangedSignal("MaxSpeed"):Connect(updateSpeedometer)
car:GetAttributeChangedSignal("TurnAngle"):Connect(updateSteerLimits)
RunService.Heartbeat:Connect(drive)
]]></ProtectedString>
