		<Item class="Script" referent="RBX73819DB6271A4066A5CCCBC1116E7CD4">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Счёт матча (урок 20). Считает по каждому игроку попадания и поражения,
-- складывает их по командам и рассылает итог на экраны.
--
-- Модуль намеренно НИЧЕГО не настраивает у оружия и не лезет внутрь системы
-- стрельбы: он только читает и складывает. Поэтому его можно поставить в любой
-- плейс с оружием курса, и наоборот — убрать, ничего не сломав.
--
-- Договор с системой стрельбы ровно один: попав, она увеличивает у стрелявшего
-- атрибут Hits (Player:SetAttribute("Hits", ...)). Больше между модулями нет
-- ничего — ни общих событий, ни требований к порядку установки. Нет системы
-- стрельбы — попадания просто останутся нулями, а поражения считаться будут.
--
-- Почему не «кто кого убил»: на арене курса важен не последний выстрел, а то,
-- сколько раз игрок попал. Попадание видно сразу и не зависит от того, добил
-- ли ты соперника или это сделал сосед, — спорить не о чем.

local Players = game:GetService("Players")
local Teams = game:GetService("Teams")

local module = script.Parent
local updateEvent = module:WaitForChild("Update")

local STAT_HITS = "\208\159\208\190\208\191\208\176\208\180\208\176\208\189\208\184\209\143"      -- Попадания
local STAT_DOWNS = "\208\159\208\190\209\128\208\176\208\182\208\181\208\189\208\184\209\143"    -- Поражения
local STAT_DIFF = "\208\160\208\176\208\183\208\189\208\184\209\134\208\176"                      -- Разница

-- Счёт держим здесь, а не только в leaderstats: значения IntValue игрок
-- изменить не может, но читать удобнее из своей таблицы.
local score = {}

local function stat(player, name)
	local board = player:FindFirstChild("leaderstats")
	return board and board:FindFirstChild(name)
end

local function refresh(player)
	local s = score[player]
	if not s then
		return
	end
	local hits, downs = stat(player, STAT_HITS), stat(player, STAT_DOWNS)
	local diff = stat(player, STAT_DIFF)
	if hits then hits.Value = s.hits end
	if downs then downs.Value = s.downs end
	if diff then diff.Value = s.hits - s.downs end
end

-- Итог по командам. Считаем по живому списку игроков, а не по накопленной
-- таблице: игрок мог сменить команду или выйти, и старая сумма врала бы.
local function teamTotals()
	local rows = {}
	for _, team in ipairs(Teams:GetTeams()) do
		rows[#rows + 1] = {
			name = team.Name,
			color = team.TeamColor.Color,
			hits = 0,
			downs = 0,
		}
	end
	local byName = {}
	for _, row in ipairs(rows) do
		byName[row.name] = row
	end
	for player, s in pairs(score) do
		local row = player.Team and byName[player.Team.Name]
		if row then
			row.hits = row.hits + s.hits
			row.downs = row.downs + s.downs
		end
	end
	return rows
end

local function broadcast()
	updateEvent:FireAllClients(teamTotals())
end

local function board(player)
	local existing = player:FindFirstChild("leaderstats")
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, name in ipairs({ STAT_HITS, STAT_DOWNS, STAT_DIFF }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Value = 0
		value.Parent = folder
	end
	folder.Parent = player
end

local function watchCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	-- Одно соединение на персонажа: после гибели персонаж пересоздаётся,
	-- и старый Humanoid вместе со своим сигналом уходит сам.
	humanoid.Died:Connect(function()
		local s = score[player]
		if not s then
			return
		end
		s.downs = s.downs + 1
		refresh(player)
		broadcast()
	end)
end

local function join(player)
	score[player] = { hits = 0, downs = 0 }
	board(player)

	-- Попадания приходят от системы стрельбы атрибутом. Читаем изменение, а не
	-- опрашиваем в цикле: счёт обновляется ровно в момент попадания.
	player:SetAttribute("Hits", 0)
	player:GetAttributeChangedSignal("Hits"):Connect(function()
		local s = score[player]
		if not s then
			return
		end
		s.hits = player:GetAttribute("Hits") or 0
		refresh(player)
		broadcast()
	end)

	player.CharacterAdded:Connect(function(character)
		watchCharacter(player, character)
	end)
	if player.Character then
		watchCharacter(player, player.Character)
	end

	-- Смена команды тоже меняет итог: очки игрока переезжают вместе с ним.
	player:GetPropertyChangedSignal("Team"):Connect(broadcast)
	broadcast()
end

local function leave(player)
	score[player] = nil
	broadcast()
end

Players.PlayerAdded:Connect(join)
Players.PlayerRemoving:Connect(leave)
for _, player in ipairs(Players:GetPlayers()) do
	join(player)
end

-- Новому клиенту нужен текущий счёт сразу, а не после ближайшего попадания.
updateEvent.OnServerEvent:Connect(function(player)
	updateEvent:FireClient(player, teamTotals())
end)
]]></ProtectedString>
				<bool name="Disabled">false</bool>
