				<string name="ScriptGuid">{90E6DECF-AE87-4723-A2A1-882AE5647694}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">ScoreServer</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX41F3291C2FE34F6386040FA0178B2F3E">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Табло счёта (урок 20): полоска вверху экрана с суммой попаданий по командам.
--
-- Личные числа игрок и так видит в списке игроков (leaderstats их показывает
-- сам), а вот командной суммы там нет — её и рисуем. Панель маленькая и стоит
-- вверху по центру: в бою смотрят в центр экрана, туда же уходит и взгляд
-- за счётом.
--
-- Клиент только показывает. Считает сервер, поэтому подрисовать себе очки,
-- поправив этот скрипт, не выйдет.

local Players = game:GetService("Players")

local module = script.Parent
local updateEvent = module:WaitForChild("Update")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "ArenaScoreGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local bar = Instance.new("Frame")
bar.Name = "Bar"
bar.AnchorPoint = Vector2.new(0.5, 0)
bar.Position = UDim2.new(0.5, 0, 0, 12)
bar.Size = UDim2.new(0, 320, 0, 44)
bar.BackgroundColor3 = Color3.fromRGB(20, 22, 28)
bar.BackgroundTransparency = 0.25
bar.BorderSizePixel = 0
bar.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = bar

local layout = Instance.new("UIListLayout")
layout.FillDirection = Enum.FillDirection.Horizontal
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.VerticalAlignment = Enum.VerticalAlignment.Center
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = bar

-- Ячейка команды: цифра цветом команды, под ней название мелко. Цвет берём
-- у самой команды, поэтому переименовали или перекрасили — панель подхватит.
local function cell(index, row)
	local holder = Instance.new("Frame")
	holder.Name = "Team" .. index
	holder.LayoutOrder = index
	holder.Size = UDim2.new(0, 130, 1, 0)
	holder.BackgroundTransparency = 1
	holder.Parent = bar

	local number = Instance.new("TextLabel")
	number.Name = "Hits"
	number.Size = UDim2.new(1, 0, 0.62, 0)
	number.BackgroundTransparency = 1
	number.Font = Enum.Font.GothamBold
	number.TextScaled = true
	number.TextColor3 = row.color
	number.Text = tostring(row.hits)
	number.Parent = holder

	local name = Instance.new("TextLabel")
	name.Name = "Title"
	name.Position = UDim2.new(0, 0, 0.62, 0)
	name.Size = UDim2.new(1, 0, 0.38, 0)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.Gotham
	name.TextScaled = true
	name.TextColor3 = Color3.fromRGB(225, 228, 235)
	name.Text = row.name
	name.Parent = holder
end

local function draw(rows)
	for _, child in ipairs(bar:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	if not rows or #rows == 0 then
		bar.Visible = false
		return
	end
	bar.Visible = true
	bar.Size = UDim2.new(0, math.min(#rows, 4) * 130 + 20, 0, 44)
	for i, row in ipairs(rows) do
		cell(i, row)
	end
end

updateEvent.OnClientEvent:Connect(draw)

-- Счёт мог идти до того, как этот клиент подключился: просим текущий.
updateEvent:FireServer()
]]></ProtectedString>
